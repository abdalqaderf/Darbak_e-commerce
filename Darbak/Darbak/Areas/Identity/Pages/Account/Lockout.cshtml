@page
@model LockoutModel
@{
    ViewData["Title"] = "Account locked";
}

<section class="identity-card-page" aria-labelledby="lockout-title">
    <div class="identity-card identity-state-card">
        <div class="identity-state-mark identity-state-mark-danger" aria-hidden="true">!</div>
        <span class="section-eyebrow">Account security</span>
        <h1 id="lockout-title">Account temporarily locked</h1>
        <p class="identity-card-intro">Please try again later.</p>
        <a asp-controller="Home" asp-action="Index" class="identity-back-link">Back to home</a>
    </div>
</section>
