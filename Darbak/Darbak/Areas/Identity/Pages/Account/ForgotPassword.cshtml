@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<section class="identity-card-page" aria-labelledby="forgot-password-title">
    <div class="identity-card">
        <span class="section-eyebrow">Account access</span>
        <h1 id="forgot-password-title">Reset your password</h1>
        <p class="identity-card-intro">Enter your account email to continue.</p>

        <form method="post" class="identity-form">
            <div asp-validation-summary="ModelOnly" class="text-danger identity-validation" role="alert"></div>
            <div class="auth-field">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger auth-field-error"></span>
            </div>
            <button type="submit" class="btn btn-accent identity-submit">Continue</button>
        </form>

        <a asp-page="./Login" class="identity-back-link">Back to log in</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
