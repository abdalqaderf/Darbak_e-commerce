@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password updated";
}

<section class="identity-card-page" aria-labelledby="reset-confirmation-title">
    <div class="identity-card identity-state-card">
        <div class="identity-state-mark" aria-hidden="true">✓</div>
        <span class="section-eyebrow">Account security</span>
        <h1 id="reset-confirmation-title">Password updated</h1>
        <p class="identity-card-intro">Your new password is ready to use.</p>
        <a asp-page="./Login" class="btn btn-accent identity-submit">Log in</a>
    </div>
</section>
