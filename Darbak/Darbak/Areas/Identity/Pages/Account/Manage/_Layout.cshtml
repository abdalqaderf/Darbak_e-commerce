@{
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="account-manage-page" aria-labelledby="account-manage-title">
    <header class="account-manage-heading">
        <span class="section-eyebrow">Your Account</span>
        <h1 id="account-manage-title">Account Settings</h1>
        <p>Manage your profile, sign-in options, security, and personal data.</p>
    </header>

    <div class="account-manage-shell">
        <aside class="account-manage-sidebar">
            <partial name="_ManageNav" />
        </aside>

        <div class="account-manage-content">
            @RenderBody()
        </div>
    </div>
</section>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
