@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();

    var profileClass = ManageNavPages.IndexNavClass(ViewContext);
    var emailClass = ManageNavPages.EmailNavClass(ViewContext);
    var passwordClass = ManageNavPages.ChangePasswordNavClass(ViewContext);
    var externalClass = ManageNavPages.ExternalLoginsNavClass(ViewContext);
    var twoFactorClass = ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext);
    var personalDataClass = ManageNavPages.PersonalDataNavClass(ViewContext);

    var profileActive = profileClass?.Contains("active", StringComparison.OrdinalIgnoreCase) == true;
    var emailActive = emailClass?.Contains("active", StringComparison.OrdinalIgnoreCase) == true;
    var passwordActive = passwordClass?.Contains("active", StringComparison.OrdinalIgnoreCase) == true;
    var externalActive = externalClass?.Contains("active", StringComparison.OrdinalIgnoreCase) == true;
    var twoFactorActive = twoFactorClass?.Contains("active", StringComparison.OrdinalIgnoreCase) == true;
    var personalDataActive = personalDataClass?.Contains("active", StringComparison.OrdinalIgnoreCase) == true;
}

<nav aria-label="Account settings">
    <ul class="nav account-manage-nav">
        <li class="nav-item">
            <a class="nav-link @profileClass"
               id="profile"
               asp-page="./Index"
               aria-current="@(profileActive ? "page" : null)">Profile</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @emailClass"
               id="email"
               asp-page="./Email"
               aria-current="@(emailActive ? "page" : null)">Email</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @passwordClass"
               id="change-password"
               asp-page="./ChangePassword"
               aria-current="@(passwordActive ? "page" : null)">Password</a>
        </li>
        @if (hasExternalLogins)
        {
            <li id="external-logins" class="nav-item">
                <a id="external-login"
                   class="nav-link @externalClass"
                   asp-page="./ExternalLogins"
                   aria-current="@(externalActive ? "page" : null)">External Logins</a>
            </li>
        }
        <li class="nav-item">
            <a class="nav-link @twoFactorClass"
               id="two-factor"
               asp-page="./TwoFactorAuthentication"
               aria-current="@(twoFactorActive ? "page" : null)">Two-Factor Authentication</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @personalDataClass"
               id="personal-data"
               asp-page="./PersonalData"
               aria-current="@(personalDataActive ? "page" : null)">Personal Data</a>
        </li>
    </ul>
</nav>
