@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>Personal data</h3>

<div class="account-data-section">
    <p>Download a copy of the personal data associated with your account.</p>
    <form id="download-data" asp-page="DownloadPersonalData" method="post">
        <button class="btn btn-outline-secondary" type="submit">Download data</button>
    </form>
</div>

<div class="account-danger-section">
    <span class="account-danger-label">Permanent action</span>
    <h4>Delete account</h4>
    <p>Deleting your account permanently removes the account and cannot be undone.</p>
    <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Delete account</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
