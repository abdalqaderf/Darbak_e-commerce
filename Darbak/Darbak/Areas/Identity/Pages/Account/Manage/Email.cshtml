@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h3>Email</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post" class="account-settings-form">
    <div asp-validation-summary="All" class="text-danger identity-validation" role="alert"></div>

    <div class="account-settings-field">
        <div class="account-settings-label-row">
            <label asp-for="Email">Current email</label>
            @if (Model.IsEmailConfirmed)
            {
                <span class="account-verified-mark">Verified</span>
            }
        </div>
        <input asp-for="Email" class="form-control" disabled />
        @if (!Model.IsEmailConfirmed)
        {
            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link account-inline-action">Send verification email</button>
        }
    </div>

    <div class="account-settings-field">
        <label asp-for="Input.NewEmail">New email</label>
        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="name@example.com" />
        <span asp-validation-for="Input.NewEmail" class="text-danger auth-field-error"></span>
    </div>

    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary account-settings-submit">Change email</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
