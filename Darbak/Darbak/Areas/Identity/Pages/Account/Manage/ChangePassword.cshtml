@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3>Password</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" class="account-settings-form">
    <div asp-validation-summary="ModelOnly" class="text-danger identity-validation" role="alert"></div>

    <div class="account-settings-field">
        <label asp-for="Input.OldPassword">Current password</label>
        <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Current password" />
        <span asp-validation-for="Input.OldPassword" class="text-danger auth-field-error"></span>
    </div>

    <div class="account-settings-field">
        <label asp-for="Input.NewPassword">New password</label>
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="New password" />
        <span asp-validation-for="Input.NewPassword" class="text-danger auth-field-error"></span>
    </div>

    <div class="account-settings-field">
        <label asp-for="Input.ConfirmPassword">Confirm password</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger auth-field-error"></span>
    </div>

    <button type="submit" class="btn btn-primary account-settings-submit">Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
