@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<section class="identity-card-page" aria-labelledby="reset-password-title">
    <div class="identity-card identity-card-wide">
        <span class="section-eyebrow">Account security</span>
        <h1 id="reset-password-title">Set a new password</h1>
        <p class="identity-card-intro">Enter your email and choose a new password.</p>

        <form method="post" class="identity-form">
            <div asp-validation-summary="ModelOnly" class="text-danger identity-validation" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />

            <div class="auth-field">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger auth-field-error"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Input.Password" class="form-label">New password</label>
                <input asp-for="Input.Password" class="form-control auth-input" autocomplete="new-password" aria-required="true" placeholder="Enter a new password" />
                <span asp-validation-for="Input.Password" class="text-danger auth-field-error"></span>
            </div>
            <div class="auth-field">
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                <input asp-for="Input.ConfirmPassword" class="form-control auth-input" autocomplete="new-password" aria-required="true" placeholder="Re-enter your password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger auth-field-error"></span>
            </div>
            <button type="submit" class="btn btn-accent identity-submit">Reset password</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
