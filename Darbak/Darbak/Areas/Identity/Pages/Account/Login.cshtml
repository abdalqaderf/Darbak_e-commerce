@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<section class="auth-page" aria-labelledby="login-title">
    <div class="auth-shell">
        <aside class="auth-visual" aria-hidden="true">
            <div class="auth-visual-content">
                <div class="auth-visual-kicker">DARBAK / ACCOUNT</div>

                <div class="auth-visual-copy">
                    <span class="auth-eyebrow">Account access</span>
                    <h2>Your saved parts and orders, in one place.</h2>
                    <p>Sign in to continue shopping and manage your Darbak account.</p>
                </div>

                <div class="auth-visual-specs">
                    <div><span>01</span><strong>Wishlist</strong></div>
                    <div><span>02</span><strong>Orders</strong></div>
                    <div><span>03</span><strong>Reviews</strong></div>
                </div>
            </div>
        </aside>

        <div class="auth-panel">
            <div class="auth-panel-inner">
                <div class="auth-heading">
                    <span class="auth-eyebrow auth-eyebrow-dark">Welcome back</span>
                    <h1 id="login-title">Log in</h1>
                    <p>Enter your account details.</p>
                </div>

                <form id="account" method="post" class="auth-form">
                    <div asp-validation-summary="ModelOnly" class="auth-validation-summary text-danger" role="alert"></div>

                    <div class="auth-field">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email"
                               class="form-control auth-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger auth-field-error"></span>
                    </div>

                    <div class="auth-field">
                        <div class="auth-label-row">
                            <label asp-for="Input.Password" class="form-label">Password</label>
                            <a id="forgot-password" asp-page="./ForgotPassword" class="auth-inline-link">Forgot password?</a>
                        </div>
                        <input asp-for="Input.Password"
                               class="form-control auth-input"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Enter your password" />
                        <span asp-validation-for="Input.Password" class="text-danger auth-field-error"></span>
                    </div>

                    <div class="auth-options">
                        <div class="form-check auth-remember">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">Remember me</label>
                        </div>
                    </div>

                    <button id="login-submit" type="submit" class="btn btn-accent auth-submit">Log in</button>

                    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                    {
                        <div class="auth-divider"><span>or</span></div>
                        <div class="auth-external-actions">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit"
                                        form="external-account"
                                        class="btn btn-outline-secondary auth-provider-button"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Log in using your @provider.DisplayName account">
                                    @provider.DisplayName
                                </button>
                            }
                        </div>
                    }

                    <div class="auth-footer-links">
                        <p>New to Darbak? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></p>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="auth-secondary-link">Resend confirmation email</a>
                    </div>
                </form>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <form id="external-account"
                          asp-page="./ExternalLogin"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          method="post"
                          class="d-none"></form>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
