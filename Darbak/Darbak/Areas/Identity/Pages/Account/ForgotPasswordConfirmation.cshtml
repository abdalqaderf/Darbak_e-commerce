@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Password reset email sent";
}

<section class="identity-card-page" aria-labelledby="forgot-confirmation-title">
    <div class="identity-card identity-state-card">
        <div class="identity-state-mark" aria-hidden="true">→</div>
        <span class="section-eyebrow">Password reset</span>
        <h1 id="forgot-confirmation-title">Check your email</h1>
        <p class="identity-card-intro">Follow the password reset link sent to your email address.</p>
        <a asp-page="./Login" class="identity-back-link">Back to log in</a>
    </div>
</section>
