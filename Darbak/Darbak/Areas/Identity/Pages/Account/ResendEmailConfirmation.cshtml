@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend confirmation";
}

<section class="identity-card-page" aria-labelledby="resend-confirmation-title">
    <div class="identity-card">
        <span class="section-eyebrow">Email confirmation</span>
        <h1 id="resend-confirmation-title">Resend confirmation email</h1>
        <p class="identity-card-intro">Enter the email address used for your account.</p>

        <form method="post" class="identity-form">
            <div asp-validation-summary="All" class="text-danger identity-validation" role="alert"></div>
            <div class="auth-field">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control auth-input" aria-required="true" placeholder="name@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger auth-field-error"></span>
            </div>
            <button type="submit" class="btn btn-accent identity-submit">Resend email</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
