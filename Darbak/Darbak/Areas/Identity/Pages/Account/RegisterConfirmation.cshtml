@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirm your account";
}

<section class="identity-card-page" aria-labelledby="register-confirmation-title">
    <div class="identity-card identity-state-card">
        <div class="identity-state-mark" aria-hidden="true">✓</div>
        <span class="section-eyebrow">Account created</span>
        <h1 id="register-confirmation-title">Confirm your email</h1>

        @if (Model.DisplayConfirmAccountLink)
        {
            <p class="identity-card-intro">Complete email confirmation to activate your account.</p>
            <a id="confirm-link" class="btn btn-accent identity-submit" href="@Model.EmailConfirmationUrl">Confirm account</a>
        }
        else
        {
            <p class="identity-card-intro">Check your email and follow the confirmation link.</p>
        }
    </div>
</section>
