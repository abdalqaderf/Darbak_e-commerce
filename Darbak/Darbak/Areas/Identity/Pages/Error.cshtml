@page
@model ErrorModel
@{
    ViewData["Title"] = "Something Went Wrong";
}

<section class="system-state-page" aria-labelledby="identity-error-title">
    <div class="system-state-card">
        <div class="system-state-code" aria-hidden="true">!</div>
        <span class="section-eyebrow">Account</span>
        <h1 id="identity-error-title">Something went wrong</h1>
        <p>We could not complete the account request. You can return to the store and try again.</p>

        @if (Model.ShowRequestId)
        {
            <p class="system-state-request">
                <strong>Request ID:</strong>
                <code>@Model.RequestId</code>
            </p>
        }

        <div class="system-state-actions">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
            <a asp-page="/Account/Login" class="btn btn-outline-secondary">Account Login</a>
        </div>
    </div>
</section>
