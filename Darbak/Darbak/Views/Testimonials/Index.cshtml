@model IEnumerable<Darbak.Models.Testimonial>

@{
    ViewData["Title"] = "Testimonials";
    var testimonials = Model.ToList();
}

<nav class="darbak-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Testimonials</span>
</nav>

<section class="testimonials-page testimonials-page--editorial" aria-labelledby="testimonials-title">
    <div class="testimonials-intro">
        <div>
            <span class="section-eyebrow">Customer Feedback</span>
            <h1 id="testimonials-title">What customers share about Darbak.</h1>
            <p>Testimonials shown on this page have been approved for public display.</p>
        </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create" class="btn btn-primary">Share Your Experience</a>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login" class="testimonials-signin-link">
                Sign in to share <span aria-hidden="true">→</span>
            </a>
        }
    </div>

    @if (!testimonials.Any())
    {
        <div class="testimonials-empty" role="status">
            <span class="testimonials-empty-mark" aria-hidden="true">“</span>
            <div>
                <strong>No approved testimonials yet.</strong>
                <p>Customer feedback will appear here after moderation.</p>
            </div>
        </div>
    }
    else
    {
        <div class="testimonial-ledger">
            @for (var i = 0; i < testimonials.Count; i++)
            {
                var testimonial = testimonials[i];
                var displayName = string.IsNullOrWhiteSpace(testimonial.User?.FullName)
                    ? testimonial.User?.UserName
                    : testimonial.User.FullName;

                <article class="testimonial-ledger-row">
                    <div class="testimonial-ledger-index">@((i + 1).ToString("00"))</div>
                    <blockquote>
                        <p>“@testimonial.Content”</p>
                    </blockquote>
                    <footer>
                        <strong>@(displayName ?? "Customer")</strong>
                        <time datetime="@testimonial.CreatedAt.ToString("yyyy-MM-dd")">
                            @testimonial.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </time>
                    </footer>
                </article>
            }
        </div>
    }
</section>
