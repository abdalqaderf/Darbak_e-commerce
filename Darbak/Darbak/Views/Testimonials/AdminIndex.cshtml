@using Darbak.Models.Enums
@model IEnumerable<Darbak.Models.Testimonial>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Testimonials"; }

<div class="admin-page-heading">
    <div>
        <span class="admin-page-heading__eyebrow">Moderation</span>
        <h1>Testimonials</h1>
        <p>Review customer feedback before it is displayed publicly.</p>
    </div>
    <span class="admin-heading-count">@Model.Count() testimonials</span>
</div>

<section class="admin-panel">
    <div class="admin-panel__header">
        <div>
            <span class="admin-panel__eyebrow">Moderation Queue</span>
            <h2>Testimonial List</h2>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="admin-empty-state">
            <strong>No testimonials yet</strong>
            <span>Submitted customer feedback will appear here for moderation.</span>
        </div>
    }
    else
    {
        <div class="table-responsive" tabindex="0">
            <table class="table admin-table admin-table--content align-middle mb-0">
                <caption class="visually-hidden">Customer testimonials awaiting or receiving moderation</caption>
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Rating</th>
                        <th>Feedback</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var testimonial in Model)
                    {
                        var statusClass = testimonial.Status switch
                        {
                            ApprovalStatus.Approved => "status-badge status-badge--success",
                            ApprovalStatus.Rejected => "status-badge status-badge--danger",
                            _ => "status-badge status-badge--warning"
                        };

                        <tr>
                            <td>
                                <strong>@(string.IsNullOrWhiteSpace(testimonial.User.FullName) ? "User" : testimonial.User.FullName)</strong>
                                <small>@testimonial.User.Email</small>
                            </td>
                            <td>
                                @if (testimonial.Rating.HasValue)
                                {
                                    <div class="testimonial-stars testimonial-stars--admin" aria-label="@testimonial.Rating out of 5 stars">
                                        @for (var star = 1; star <= 5; star++)
                                        {
                                            <span class="@(star <= testimonial.Rating.Value ? "is-filled" : string.Empty)" aria-hidden="true">★</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td><p class="admin-table-comment">@testimonial.Content</p></td>
                            <td>@testimonial.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td><span class="@statusClass">@testimonial.Status</span></td>
                            <td class="text-end">
                                <div class="admin-actions">
                                    @if (testimonial.Status != ApprovalStatus.Approved)
                                    {
                                        <form asp-action="Approve" method="post">
                                            <input type="hidden" name="id" value="@testimonial.Id" />
                                            <button type="submit" class="admin-table-action admin-table-action--success">Approve</button>
                                        </form>
                                    }
                                    @if (testimonial.Status != ApprovalStatus.Rejected)
                                    {
                                        <form asp-action="Reject" method="post">
                                            <input type="hidden" name="id" value="@testimonial.Id" />
                                            <button type="submit" class="admin-table-action admin-table-action--danger">Reject</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
