@using Darbak.Models.Enums
@model IEnumerable<Darbak.Models.Order>

@{
    ViewData["Title"] = "My Orders";
    var orders = Model.OrderByDescending(o => o.OrderDate).ToList();
    var currentOrders = orders.Where(o => o.Status == OrderStatus.Processing).ToList();
    var previousOrders = orders.Where(o => o.Status == OrderStatus.Completed || o.Status == OrderStatus.Cancelled).ToList();
}

<section class="orders-page">
    <div class="container">
        <nav class="orders-breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">My Orders</span>
        </nav>

        <header class="orders-page-header">
            <div>
                <span class="orders-eyebrow">Orders</span>
                <h1>My Orders</h1>
            </div>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-dark">Continue Shopping</a>
        </header>

        @if (!orders.Any())
        {
            <div class="orders-empty-state">
                <h2>No orders yet</h2>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">Shop Parts</a>
            </div>
        }
        else
        {
            <div class="orders-summary-strip" aria-label="Orders summary">
                <div><span>Current</span><strong>@currentOrders.Count</strong></div>
                <div><span>Previous</span><strong>@previousOrders.Count</strong></div>
                <div><span>Total</span><strong>@orders.Count</strong></div>
            </div>

            <section class="orders-section" aria-labelledby="current-orders-title">
                <div class="orders-section-heading">
                    <h2 id="current-orders-title">Current Orders</h2>
                    <span>@currentOrders.Count</span>
                </div>

                @if (!currentOrders.Any())
                {
                    <div class="orders-section-empty">No orders are currently processing.</div>
                }
                else
                {
                    <div class="orders-list">
                        @foreach (var order in currentOrders)
                        {
                            var itemCount = order.OrderItems.Sum(item => item.Quantity);
                            <article class="order-row">
                                <div class="order-row-id">
                                    <span>Order</span>
                                    <strong>#@order.Id</strong>
                                    <time datetime="@order.OrderDate.ToString("O")">@order.OrderDate.ToLocalTime().ToString("MMM dd, yyyy")</time>
                                </div>

                                <div class="order-row-status">
                                    <span class="order-status-badge order-status-processing"><span class="order-status-dot"></span>Processing</span>
                                    <span class="order-status-badge @(order.PaymentStatus == PaymentStatus.Paid ? "order-payment-paid" : order.PaymentStatus == PaymentStatus.Failed ? "order-payment-failed" : order.PaymentStatus == PaymentStatus.Refunded ? "order-payment-refunded" : "order-payment-pending")">
                                        @(order.PaymentStatus == PaymentStatus.Pending ? "Payment Pending" : order.PaymentStatus.ToString())
                                    </span>
                                </div>

                                <div class="order-row-meta">
                                    <div><span>Items</span><strong>@itemCount</strong></div>
                                    <div><span>Ship to</span><strong>@order.City</strong></div>
                                </div>

                                <div class="order-row-total">
                                    <span>Total</span>
                                    <strong>@order.TotalAmount.ToString("0.00") JD</strong>
                                </div>

                                <div class="order-row-actions">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-primary">Details</a>
                                    <a asp-action="Invoice" asp-route-id="@order.Id" class="order-text-link">Invoice</a>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="orders-section orders-section-previous" aria-labelledby="previous-orders-title">
                <div class="orders-section-heading">
                    <h2 id="previous-orders-title">Previous Orders</h2>
                    <span>@previousOrders.Count</span>
                </div>

                @if (!previousOrders.Any())
                {
                    <div class="orders-section-empty">Completed and cancelled orders will appear here.</div>
                }
                else
                {
                    <div class="orders-list">
                        @foreach (var order in previousOrders)
                        {
                            var itemCount = order.OrderItems.Sum(item => item.Quantity);
                            var statusClass = order.Status == OrderStatus.Completed ? "order-status-completed" : "order-status-cancelled";
                            <article class="order-row">
                                <div class="order-row-id">
                                    <span>Order</span>
                                    <strong>#@order.Id</strong>
                                    <time datetime="@order.OrderDate.ToString("O")">@order.OrderDate.ToLocalTime().ToString("MMM dd, yyyy")</time>
                                </div>

                                <div class="order-row-status">
                                    <span class="order-status-badge @statusClass"><span class="order-status-dot"></span>@order.Status</span>
                                    <span class="order-status-badge @(order.PaymentStatus == PaymentStatus.Paid ? "order-payment-paid" : order.PaymentStatus == PaymentStatus.Failed ? "order-payment-failed" : order.PaymentStatus == PaymentStatus.Refunded ? "order-payment-refunded" : "order-payment-pending")">
                                        @(order.PaymentStatus == PaymentStatus.Pending ? "Payment Pending" : order.PaymentStatus.ToString())
                                    </span>
                                </div>

                                <div class="order-row-meta">
                                    <div><span>Items</span><strong>@itemCount</strong></div>
                                    <div><span>Ship to</span><strong>@order.City</strong></div>
                                </div>

                                <div class="order-row-total">
                                    <span>Total</span>
                                    <strong>@order.TotalAmount.ToString("0.00") JD</strong>
                                </div>

                                <div class="order-row-actions">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-dark">Details</a>
                                    <a asp-action="Invoice" asp-route-id="@order.Id" class="order-text-link">Invoice</a>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    </div>
</section>
