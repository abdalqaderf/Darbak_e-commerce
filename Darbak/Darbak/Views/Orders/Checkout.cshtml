@model Darbak.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
    var itemCount = Model.CartItems.Sum(item => item.Quantity);
}

<section class="checkout-page" aria-labelledby="checkout-title">
    <div class="container">
        <nav class="page-breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span aria-hidden="true">/</span>
            <a asp-controller="Cart" asp-action="Index">Cart</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Checkout</span>
        </nav>

        <header class="checkout-heading">
            <div class="checkout-heading-copy">
                <span class="section-eyebrow">Checkout</span>
                <h1 id="checkout-title">Shipping details</h1>
            </div>

            <ol class="checkout-steps" aria-label="Checkout progress">
                <li class="checkout-step checkout-step-complete">
                    <span class="checkout-step-number" aria-hidden="true">1</span>
                    <span>Cart</span>
                </li>
                <li class="checkout-step checkout-step-active" aria-current="step">
                    <span class="checkout-step-number" aria-hidden="true">2</span>
                    <span>Details</span>
                </li>
                <li class="checkout-step">
                    <span class="checkout-step-number" aria-hidden="true">3</span>
                    <span>Confirm</span>
                </li>
            </ol>
        </header>

        <form asp-action="Checkout" method="post" id="checkoutForm">
            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger checkout-validation-summary"
                     role="alert">
                </div>
            }

            <div class="checkout-layout">
                <main class="checkout-main">
                    <section class="checkout-card checkout-shipping-card" aria-labelledby="shipping-heading">
                        <div class="checkout-card-header">
                            <div>
                                <span class="checkout-card-index">01</span>
                                <h2 id="shipping-heading">Delivery information</h2>
                            </div>
                        </div>

                        <div class="checkout-card-body">
                            <div class="checkout-field checkout-field-wide">
                                <label asp-for="ShippingAddress" class="form-label"></label>
                                <input asp-for="ShippingAddress"
                                       class="form-control"
                                       autocomplete="street-address"
                                       placeholder="Street address" />
                                <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                            </div>

                            <div class="checkout-field-grid">
                                <div class="checkout-field">
                                    <label asp-for="City" class="form-label"></label>
                                    <input asp-for="City"
                                           class="form-control"
                                           autocomplete="address-level2"
                                           placeholder="City" />
                                    <span asp-validation-for="City" class="text-danger"></span>
                                </div>

                                <div class="checkout-field">
                                    <label asp-for="PhoneNumber" class="form-label"></label>
                                    <input asp-for="PhoneNumber"
                                           type="tel"
                                           class="form-control"
                                           autocomplete="tel"
                                           inputmode="tel"
                                           placeholder="Phone number" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </section>
                </main>

                <aside class="checkout-sidebar" aria-labelledby="summary-heading">
                    <section class="checkout-summary-card">
                        <div class="checkout-summary-header">
                            <div>
                                <span class="checkout-summary-kicker">Order</span>
                                <h2 id="summary-heading">Summary</h2>
                            </div>
                            <span class="checkout-item-count">
                                @itemCount @(itemCount == 1 ? "item" : "items")
                            </span>
                        </div>

                        <div class="checkout-summary-items">
                            @foreach (var item in Model.CartItems)
                            {
                                <article class="checkout-summary-item">
                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@item.ProductId"
                                       class="checkout-summary-image"
                                       aria-label="View @item.ProductName">
                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.ProductName" />
                                        }
                                        else
                                        {
                                            <span class="checkout-image-placeholder" aria-hidden="true">DBK</span>
                                        }
                                    </a>

                                    <div class="checkout-summary-product">
                                        <a asp-controller="Products"
                                           asp-action="Details"
                                           asp-route-id="@item.ProductId"
                                           class="checkout-summary-name">
                                            @item.ProductName
                                        </a>
                                        <span>@item.Quantity × @item.Price.ToString("0.00") JD</span>
                                    </div>

                                    <strong class="checkout-summary-line-total">
                                        @item.Total.ToString("0.00") JD
                                    </strong>
                                </article>
                            }
                        </div>

                        <div class="checkout-totals">
                            <div class="checkout-total-row">
                                <span>Subtotal</span>
                                <span>@Model.TotalAmount.ToString("0.00") JD</span>
                            </div>
                            <div class="checkout-total-row checkout-total-row-final">
                                <span>Total</span>
                                <strong>@Model.TotalAmount.ToString("0.00") JD</strong>
                            </div>
                        </div>

                        <div class="checkout-summary-actions">
                            <button type="submit"
                                    id="continueButton"
                                    class="checkout-primary-action">
                                <span>Continue</span>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="m9 18 6-6-6-6" />
                                </svg>
                            </button>

                            <a asp-controller="Cart"
                               asp-action="Index"
                               class="checkout-secondary-action">
                                Back to cart
                            </a>
                        </div>
                    </section>
                </aside>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const form = document.getElementById("checkoutForm");
            const button = document.getElementById("continueButton");

            if (!form || !button) {
                return;
            }

            form.addEventListener("submit", function () {
                if (window.jQuery && !window.jQuery(form).valid()) {
                    return;
                }

                button.disabled = true;
                button.setAttribute("aria-busy", "true");

                const label = button.querySelector("span");
                if (label) {
                    label.textContent = "Continuing...";
                }
            });
        })();
    </script>
}
