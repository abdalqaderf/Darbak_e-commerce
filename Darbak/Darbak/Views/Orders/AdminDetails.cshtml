@using Darbak.Models.Enums
@model Darbak.Models.Order
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Order #{Model.Id}";
    var orderClass = Model.Status switch { OrderStatus.Completed => "status-badge status-badge--success", OrderStatus.Cancelled => "status-badge status-badge--danger", _ => "status-badge status-badge--warning" };
    var paymentClass = Model.PaymentStatus switch { PaymentStatus.Paid => "status-badge status-badge--success", PaymentStatus.Failed => "status-badge status-badge--danger", PaymentStatus.Refunded => "status-badge status-badge--info", _ => "status-badge status-badge--warning" };
}
<div class="admin-page-heading"><div><span class="admin-page-heading__eyebrow">Sales / Order #@Model.Id</span><h1>Manage Order #@Model.Id</h1><p>Review customer, shipping, items, and order state.</p></div><div class="d-flex gap-2 flex-wrap"><a asp-action="Invoice" asp-route-id="@Model.Id" class="btn btn-outline-secondary">View Invoice</a><a asp-action="AdminIndex" class="btn btn-outline-secondary">Back to Orders</a></div></div>
<div class="admin-detail-summary"><div><span>Order Status</span><strong><span class="@orderClass">@Model.Status</span></strong></div><div><span>Payment Status</span><strong><span class="@paymentClass">@Model.PaymentStatus</span></strong></div><div><span>Order Date</span><strong>@Model.OrderDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong></div><div><span>Total</span><strong>@Model.TotalAmount.ToString("0.00") JD</strong></div></div>
<div class="admin-dashboard-grid admin-dashboard-grid--equal">
<section class="admin-panel"><div class="admin-panel__header"><div><span class="admin-panel__eyebrow">Customer</span><h2>Customer Information</h2></div></div><div class="admin-definition-list"><div><span>Name</span><strong>@(string.IsNullOrWhiteSpace(Model.User.FullName) ? "Not provided" : Model.User.FullName)</strong></div><div><span>Email</span><strong>@Model.User.Email</strong></div></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><span class="admin-panel__eyebrow">Delivery</span><h2>Shipping Information</h2></div></div><div class="admin-definition-list"><div><span>Address</span><strong>@Model.ShippingAddress</strong></div><div><span>City</span><strong>@Model.City</strong></div><div><span>Phone</span><strong>@Model.PhoneNumber</strong></div></div></section>
</div>
<div class="admin-dashboard-grid admin-dashboard-grid--equal">
<section class="admin-panel"><div class="admin-panel__header"><div><span class="admin-panel__eyebrow">Workflow</span><h2>Update Order Status</h2></div></div><form asp-action="UpdateStatus" method="post" class="admin-inline-status-form"><input type="hidden" name="id" value="@Model.Id" /><label for="orderStatus">Order Status</label><select name="status" id="orderStatus" class="form-select">@foreach (var value in Enum.GetValues<OrderStatus>()) { if (value == Model.Status) { <option value="@value" selected>@value</option> } else { <option value="@value">@value</option> } }</select><button type="submit" class="btn btn-primary">Update Status</button></form></section>
<section class="admin-panel"><div class="admin-panel__header"><div><span class="admin-panel__eyebrow">Payment</span><h2>Update Payment Status</h2></div></div><form asp-action="UpdatePaymentStatus" method="post" class="admin-inline-status-form"><input type="hidden" name="id" value="@Model.Id" /><label for="paymentStatus">Payment Status</label><select name="paymentStatus" id="paymentStatus" class="form-select">@foreach (var value in Enum.GetValues<PaymentStatus>()) { if (value == Model.PaymentStatus) { <option value="@value" selected>@value</option> } else { <option value="@value">@value</option> } }</select><button type="submit" class="btn btn-primary">Update Payment</button></form></section>
</div>
<section class="admin-panel"><div class="admin-panel__header"><div><span class="admin-panel__eyebrow">Items</span><h2>Order Products</h2></div><strong>@Model.OrderItems.Sum(i => i.Quantity) item(s)</strong></div><div class="table-responsive" tabindex="0"><table class="table admin-table align-middle mb-0"><caption class="visually-hidden">Products included in this order</caption><thead><tr><th>Product</th><th>Unit Price</th><th>Quantity</th><th class="text-end">Line Total</th></tr></thead><tbody>@foreach (var item in Model.OrderItems) { <tr><td><strong>@item.ProductName</strong></td><td>@item.UnitPrice.ToString("0.00") JD</td><td>@item.Quantity</td><td class="text-end"><strong>@((item.UnitPrice * item.Quantity).ToString("0.00")) JD</strong></td></tr> }</tbody><tfoot><tr><td colspan="3"><strong>Grand Total</strong></td><td class="text-end"><strong>@Model.TotalAmount.ToString("0.00") JD</strong></td></tr></tfoot></table></div></section>
