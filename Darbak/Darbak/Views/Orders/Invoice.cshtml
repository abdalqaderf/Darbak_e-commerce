@using Darbak.Models.Enums
@model Darbak.Models.Order

@{
    ViewData["Title"] = $"Invoice #{Model.Id}";
    var itemCount = Model.OrderItems.Sum(item => item.Quantity);
}

<div class="invoice-page">
    <div class="invoice-toolbar no-print">
        <a asp-action="@(User.IsInRole("Admin") ? "AdminDetails" : "Details")" asp-route-id="@Model.Id" class="invoice-back-link">← Back to Order</a>
        <button type="button" class="btn btn-primary" onclick="window.print();">Print Invoice</button>
    </div>

    <article class="invoice-sheet" aria-label="Invoice for order @Model.Id">
        <header class="invoice-header">
            <div class="invoice-brand">
                <div class="invoice-brand-name">DAR<span>BAK</span></div>
                <div class="invoice-brand-tagline">AUTO PARTS &amp; CAR ACCESSORIES</div>
            </div>
            <div class="invoice-heading-block">
                <span class="invoice-label">Invoice</span>
                <h1>#@Model.Id</h1>
                <time datetime="@Model.OrderDate.ToString("O")">@Model.OrderDate.ToLocalTime().ToString("MMMM dd, yyyy")</time>
            </div>
        </header>

        <div class="invoice-rule"></div>

        <div class="invoice-party-grid">
            <section>
                <span class="invoice-section-label">Customer</span>
                <h2>@(string.IsNullOrWhiteSpace(Model.User?.FullName) ? "Customer" : Model.User.FullName)</h2>
                @if (!string.IsNullOrWhiteSpace(Model.User?.Email)) { <p>@Model.User.Email</p> }
                <p>@Model.PhoneNumber</p>
            </section>
            <section>
                <span class="invoice-section-label">Ship To</span>
                <h2>@Model.City</h2>
                <p>@Model.ShippingAddress</p>
                <p>@Model.PhoneNumber</p>
            </section>
            <section class="invoice-order-meta">
                <span class="invoice-section-label">Order</span>
                <dl>
                    <div><dt>Status</dt><dd>@Model.Status</dd></div>
                    <div><dt>Payment</dt><dd>@Model.PaymentStatus</dd></div>
                    <div><dt>Items</dt><dd>@itemCount</dd></div>
                </dl>
            </section>
        </div>

        <section class="invoice-items" aria-labelledby="invoice-items-heading">
            <h2 id="invoice-items-heading" class="visually-hidden">Invoice items</h2>
            <div class="table-responsive" tabindex="0">
                <table class="table invoice-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td><strong>@item.ProductName</strong></td>
                                <td class="text-end text-nowrap">@item.UnitPrice.ToString("0.00") JD</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end text-nowrap fw-bold">@((item.UnitPrice * item.Quantity).ToString("0.00")) JD</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <div class="invoice-total-area">
            <span>Grand Total</span>
            <strong>@Model.TotalAmount.ToString("0.00") JD</strong>
        </div>

        <footer class="invoice-footer-note">
            <span>Darbak</span>
            <span>Invoice #@Model.Id</span>
        </footer>
    </article>
</div>
