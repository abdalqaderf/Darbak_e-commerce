@using Darbak.Models.Enums
@model IEnumerable<Darbak.Models.Order>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Orders";
    string? selectedStatus = ViewBag.Status as string;
    string? selectedPaymentStatus = ViewBag.PaymentStatus as string;
    string? userFilter = ViewBag.UserFilter as string;
    string? fromDate = ViewBag.FromDate as string;
    string? toDate = ViewBag.ToDate as string;
}
<div class="admin-page-heading"><div><span class="admin-page-heading__eyebrow">Sales</span><h1>Orders</h1><p>Search customer orders and review order and payment status.</p></div><span class="admin-heading-count">@Model.Count() orders</span></div>
<section class="admin-filter-panel" aria-labelledby="order-filter-title"><div class="admin-filter-panel__header"><div><span>Filters</span><h2 id="order-filter-title">Find Orders</h2></div><span class="admin-result-count">@Model.Count() result(s)</span></div>
<form asp-action="AdminIndex" method="get" class="admin-filter-grid admin-filter-grid--orders">
<div class="admin-filter-field"><label for="orderId">Order ID</label><input type="number" id="orderId" name="orderId" value="@ViewBag.OrderId" min="1" class="form-control" placeholder="Order #" /></div>
<div class="admin-filter-field admin-filter-field--wide"><label for="user">User / Email</label><input type="search" id="user" name="user" value="@userFilter" class="form-control" placeholder="Name or email" /></div>
<div class="admin-filter-field"><label for="status">Order Status</label><select id="status" name="status" class="form-select"><option value="">All Statuses</option>@foreach (var value in Enum.GetValues<OrderStatus>()) { if (selectedStatus == value.ToString()) { <option value="@value" selected>@value</option> } else { <option value="@value">@value</option> } }</select></div>
<div class="admin-filter-field"><label for="paymentStatus">Payment Status</label><select id="paymentStatus" name="paymentStatus" class="form-select"><option value="">All Payments</option>@foreach (var value in Enum.GetValues<PaymentStatus>()) { if (selectedPaymentStatus == value.ToString()) { <option value="@value" selected>@value</option> } else { <option value="@value">@value</option> } }</select></div>
<div class="admin-filter-field"><label for="fromDate">From Date</label><input type="date" id="fromDate" name="fromDate" value="@fromDate" class="form-control" /></div>
<div class="admin-filter-field"><label for="toDate">To Date</label><input type="date" id="toDate" name="toDate" value="@toDate" class="form-control" /></div>
<div class="admin-filter-actions"><button type="submit" class="btn btn-primary">Apply Filters</button><a asp-action="AdminIndex" class="btn btn-outline-secondary">Reset</a></div>
</form></section>
<section class="admin-panel"><div class="admin-panel__header"><div><span class="admin-panel__eyebrow">Sales</span><h2>Order List</h2></div></div>
@if (!Model.Any()) { <div class="admin-empty-state"><strong>No orders found</strong><span>No orders match the selected filters.</span><a asp-action="AdminIndex" class="btn btn-outline-secondary btn-sm">Clear Filters</a></div> }
else { <div class="table-responsive" tabindex="0"><table class="table admin-table align-middle mb-0"><caption class="visually-hidden">Filtered store orders</caption><thead><tr><th>Order</th><th>Customer</th><th>Date</th><th>Total</th><th>Order Status</th><th>Payment</th><th class="text-end">Actions</th></tr></thead><tbody>
@foreach (var order in Model) {
    var orderClass = order.Status switch { OrderStatus.Completed => "status-badge status-badge--success", OrderStatus.Cancelled => "status-badge status-badge--danger", _ => "status-badge status-badge--warning" };
    var paymentClass = order.PaymentStatus switch { PaymentStatus.Paid => "status-badge status-badge--success", PaymentStatus.Failed => "status-badge status-badge--danger", PaymentStatus.Refunded => "status-badge status-badge--info", _ => "status-badge status-badge--warning" };
<tr><td><strong>#@order.Id</strong></td><td><strong>@(string.IsNullOrWhiteSpace(order.User.FullName) ? "User" : order.User.FullName)</strong><small>@order.User.Email</small></td><td>@order.OrderDate.ToLocalTime().ToString("dd MMM yyyy")<small>@order.OrderDate.ToLocalTime().ToString("HH:mm")</small></td><td><strong>@order.TotalAmount.ToString("0.00")</strong></td><td><span class="@orderClass">@order.Status</span></td><td><span class="@paymentClass">@order.PaymentStatus</span></td><td class="text-end"><div class="admin-actions"><a asp-action="AdminDetails" asp-route-id="@order.Id" class="admin-table-action">Details</a><a asp-action="Invoice" asp-route-id="@order.Id" class="admin-table-action">Invoice</a></div></td></tr> }
</tbody></table></div> }
</section>
