@model Darbak.ViewModels.MockPaymentViewModel

@{
    ViewData["Title"] = "Confirm Order";
    var itemCount = Model.CartItems.Sum(item => item.Quantity);
}

<section class="checkout-page payment-page" aria-labelledby="payment-title">
    <div class="container">
        <nav class="page-breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span aria-hidden="true">/</span>
            <a asp-controller="Cart" asp-action="Index">Cart</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Confirm</span>
        </nav>

        <header class="checkout-heading">
            <div class="checkout-heading-copy">
                <span class="section-eyebrow">Final step</span>
                <h1 id="payment-title">Review & confirm</h1>
            </div>

            <ol class="checkout-steps" aria-label="Checkout progress">
                <li class="checkout-step checkout-step-complete">
                    <span class="checkout-step-number" aria-hidden="true">1</span>
                    <span>Cart</span>
                </li>
                <li class="checkout-step checkout-step-complete">
                    <span class="checkout-step-number" aria-hidden="true">2</span>
                    <span>Details</span>
                </li>
                <li class="checkout-step checkout-step-active" aria-current="step">
                    <span class="checkout-step-number" aria-hidden="true">3</span>
                    <span>Confirm</span>
                </li>
            </ol>
        </header>

        <div class="checkout-layout payment-layout">
            <main class="checkout-main">
                <section class="checkout-card payment-review-card" aria-labelledby="payment-shipping-heading">
                    <div class="checkout-card-header">
                        <div>
                            <span class="checkout-card-index">01</span>
                            <h2 id="payment-shipping-heading">Delivery information</h2>
                        </div>
                        <a asp-action="Checkout" class="payment-edit-link">Edit</a>
                    </div>

                    <div class="payment-shipping-details">
                        <div class="payment-detail-row">
                            <span>Address</span>
                            <strong>@Model.ShippingAddress</strong>
                        </div>
                        <div class="payment-detail-row">
                            <span>City</span>
                            <strong>@Model.City</strong>
                        </div>
                        <div class="payment-detail-row">
                            <span>Phone</span>
                            <strong>@Model.PhoneNumber</strong>
                        </div>
                    </div>
                </section>

                <section class="payment-confirm-strip" aria-label="Order confirmation">
                    <span class="payment-confirm-index">02</span>
                    <div>
                        <strong>Order ready</strong>
                        <span>Confirm the order after reviewing the total and delivery details.</span>
                    </div>
                </section>
            </main>

            <aside class="checkout-sidebar" aria-labelledby="payment-summary-heading">
                <section class="checkout-summary-card">
                    <div class="checkout-summary-header">
                        <div>
                            <span class="checkout-summary-kicker">Final total</span>
                            <h2 id="payment-summary-heading">Order summary</h2>
                        </div>
                        <span class="checkout-item-count">
                            @itemCount @(itemCount == 1 ? "item" : "items")
                        </span>
                    </div>

                    <div class="checkout-summary-items">
                        @foreach (var item in Model.CartItems)
                        {
                            <article class="checkout-summary-item">
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@item.ProductId"
                                   class="checkout-summary-image"
                                   aria-label="View @item.ProductName">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" />
                                    }
                                    else
                                    {
                                        <span class="checkout-image-placeholder" aria-hidden="true">DBK</span>
                                    }
                                </a>

                                <div class="checkout-summary-product">
                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@item.ProductId"
                                       class="checkout-summary-name">
                                        @item.ProductName
                                    </a>
                                    <span>@item.Quantity × @item.Price.ToString("0.00") JD</span>
                                </div>

                                <strong class="checkout-summary-line-total">
                                    @item.Total.ToString("0.00") JD
                                </strong>
                            </article>
                        }
                    </div>

                    <div class="checkout-totals">
                        <div class="checkout-total-row">
                            <span>Subtotal</span>
                            <span>@Model.TotalAmount.ToString("0.00") JD</span>
                        </div>
                        <div class="checkout-total-row checkout-total-row-final">
                            <span>Total</span>
                            <strong>@Model.TotalAmount.ToString("0.00") JD</strong>
                        </div>
                    </div>

                    <div class="checkout-summary-actions payment-actions">
                        <form asp-action="CompletePayment" method="post" id="paymentForm">
                            <input type="hidden" name="paymentToken" value="@Model.PaymentToken" />
                            <button type="submit"
                                    id="completePaymentButton"
                                    class="checkout-primary-action">
                                <span>Confirm order</span>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="m9 18 6-6-6-6" />
                                </svg>
                            </button>
                        </form>

                        <form asp-action="CancelPayment"
                              method="post"
                              data-confirm
                              data-confirm-title="Cancel checkout?"
                              data-confirm-message="Your cart will remain available if you cancel this checkout."
                              data-confirm-button="Cancel checkout">
                            <button type="submit" class="checkout-secondary-action checkout-secondary-button">
                                Cancel
                            </button>
                        </form>
                    </div>
                </section>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("paymentForm");
            const button = document.getElementById("completePaymentButton");

            if (!form || !button) {
                return;
            }

            form.addEventListener("submit", function () {
                button.disabled = true;
                button.setAttribute("aria-busy", "true");

                const label = button.querySelector("span");
                if (label) {
                    label.textContent = "Confirming...";
                }
            });
        })();
    </script>
}
