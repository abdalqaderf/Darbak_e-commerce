@model Darbak.ViewModels.MockPaymentViewModel

@{
    ViewData["Title"] = "Payment";
}

<section class="checkout-page payment-page" aria-labelledby="payment-title">
    <div class="container">
        <nav class="page-breadcrumb" aria-label="Breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span aria-hidden="true">/</span>
            <a asp-controller="Cart" asp-action="Index">Cart</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Payment</span>
        </nav>

        <div class="checkout-heading">
            <div>
                <span class="section-eyebrow">Final review</span>
                <h1 id="payment-title">Payment</h1>
                <p>Review your shipping information and order total before completing the current demo payment flow.</p>
            </div>

            <ol class="checkout-steps" aria-label="Checkout progress">
                <li class="checkout-step checkout-step-complete">
                    <span class="checkout-step-number" aria-hidden="true">1</span>
                    <span>Cart</span>
                </li>
                <li class="checkout-step checkout-step-complete">
                    <span class="checkout-step-number" aria-hidden="true">2</span>
                    <span>Details</span>
                </li>
                <li class="checkout-step checkout-step-active" aria-current="step">
                    <span class="checkout-step-number" aria-hidden="true">3</span>
                    <span>Payment</span>
                </li>
            </ol>
        </div>

        <div class="payment-demo-notice" role="note">
            <span class="payment-demo-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z" />
                    <path d="M12 11v6M12 7h.01" />
                </svg>
            </span>
            <div>
                <strong>Demo Payment</strong>
                <p>This project currently uses a simulated payment flow. Do not enter real card or payment information.</p>
            </div>
        </div>

        <div class="checkout-layout payment-layout">
            <div class="checkout-main">
                <section class="checkout-card" aria-labelledby="payment-shipping-heading">
                    <div class="checkout-card-header">
                        <span class="checkout-card-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M12 21s7-5.3 7-12a7 7 0 1 0-14 0c0 6.7 7 12 7 12Z" />
                                <circle cx="12" cy="9" r="2.4" />
                            </svg>
                        </span>
                        <div>
                            <h2 id="payment-shipping-heading">Shipping Information</h2>
                            <p>Confirm the details you entered during checkout.</p>
                        </div>
                    </div>

                    <div class="payment-shipping-details">
                        <div class="payment-detail-row">
                            <span>Shipping Address</span>
                            <strong>@Model.ShippingAddress</strong>
                        </div>
                        <div class="payment-detail-row">
                            <span>City</span>
                            <strong>@Model.City</strong>
                        </div>
                        <div class="payment-detail-row">
                            <span>Phone Number</span>
                            <strong>@Model.PhoneNumber</strong>
                        </div>
                    </div>
                </section>

                <section class="checkout-card payment-method-card" aria-labelledby="payment-method-heading">
                    <div class="checkout-card-header">
                        <span class="checkout-card-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="2.5" y="5" width="19" height="14" rx="2" />
                                <path d="M2.5 9h19M6.5 15h3" />
                            </svg>
                        </span>
                        <div>
                            <h2 id="payment-method-heading">Payment Method</h2>
                            <p>The current project flow simulates payment completion without collecting card details.</p>
                        </div>
                    </div>

                    <div class="payment-method-demo">
                        <span class="payment-method-marker" aria-hidden="true"></span>
                        <div>
                            <strong>Demo payment</strong>
                            <span>No real payment credentials required</span>
                        </div>
                    </div>
                </section>
            </div>

            <aside class="checkout-sidebar" aria-labelledby="payment-summary-heading">
                <section class="checkout-summary-card">
                    <div class="checkout-summary-header">
                        <div>
                            <span class="section-eyebrow">Final total</span>
                            <h2 id="payment-summary-heading">Order Summary</h2>
                        </div>
                        <span class="checkout-item-count">
                            @Model.CartItems.Sum(item => item.Quantity)
                            @(Model.CartItems.Sum(item => item.Quantity) == 1 ? "item" : "items")
                        </span>
                    </div>

                    <div class="checkout-summary-items">
                        @foreach (var item in Model.CartItems)
                        {
                            <article class="checkout-summary-item">
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@item.ProductId"
                                   class="checkout-summary-image"
                                   aria-label="View @item.ProductName">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" />
                                    }
                                    else
                                    {
                                        <span class="checkout-image-placeholder" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                                                <path d="M3 17.5 7.5 13l3.5 3.5 2.5-2.5L21 21H3v-3.5Z" />
                                                <path d="M3 3h18v18H3z" />
                                                <circle cx="15.5" cy="8.5" r="1.5" />
                                            </svg>
                                        </span>
                                    }
                                </a>

                                <div class="checkout-summary-product">
                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@item.ProductId"
                                       class="checkout-summary-name">
                                        @item.ProductName
                                    </a>
                                    <span>Qty: @item.Quantity</span>
                                    <span>@item.Price.ToString("0.00") each</span>
                                </div>

                                <strong class="checkout-summary-line-total">
                                    @item.Total.ToString("0.00")
                                </strong>
                            </article>
                        }
                    </div>

                    <div class="checkout-totals">
                        <div class="checkout-total-row">
                            <span>Subtotal</span>
                            <span>@Model.TotalAmount.ToString("0.00")</span>
                        </div>
                        <div class="checkout-total-row checkout-total-row-final">
                            <span>Total</span>
                            <strong>@Model.TotalAmount.ToString("0.00")</strong>
                        </div>
                    </div>

                    <div class="checkout-summary-actions payment-actions">
                        <form asp-action="CompletePayment" method="post" id="paymentForm">
                            <input type="hidden" name="paymentToken" value="@Model.PaymentToken" />
                            <button type="submit"
                                    id="completePaymentButton"
                                    class="btn btn-primary btn-lg w-100">
                                <span>Complete Demo Payment</span>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="m9 18 6-6-6-6" />
                                </svg>
                            </button>
                        </form>

                        <form asp-action="CancelPayment" method="post">
                            <button type="submit" class="btn btn-outline-secondary w-100">
                                Cancel Payment
                            </button>
                        </form>
                    </div>

                    <p class="checkout-summary-note">
                        Completing the demo payment runs the existing order creation flow.
                    </p>
                </section>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("paymentForm");
            const button = document.getElementById("completePaymentButton");

            if (!form || !button) {
                return;
            }

            form.addEventListener("submit", function () {
                button.disabled = true;
                button.setAttribute("aria-busy", "true");

                const label = button.querySelector("span");
                if (label) {
                    label.textContent = "Processing...";
                }
            });
        })();
    </script>
}
