@using Darbak.Models.Enums
@model Darbak.Models.Order

@{
    ViewData["Title"] = $"Order #{Model.Id}";
    var orderStatusClass = Model.Status switch
    {
        OrderStatus.Completed => "order-status-completed",
        OrderStatus.Cancelled => "order-status-cancelled",
        _ => "order-status-processing"
    };
    var paymentStatusClass = Model.PaymentStatus switch
    {
        PaymentStatus.Paid => "order-payment-paid",
        PaymentStatus.Failed => "order-payment-failed",
        PaymentStatus.Refunded => "order-payment-refunded",
        _ => "order-payment-pending"
    };
    var itemCount = Model.OrderItems.Sum(item => item.Quantity);
}

<div class="order-details-page">
    <nav class="orders-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span>/</span>
        <a asp-action="Index">My Orders</a>
        <span>/</span>
        <span aria-current="page">#@Model.Id</span>
    </nav>

    <header class="order-details-header">
        <div>
            <span class="orders-eyebrow">Order</span>
            <h1>#@Model.Id</h1>
            <time datetime="@Model.OrderDate.ToString("O")">@Model.OrderDate.ToLocalTime().ToString("MMMM dd, yyyy · HH:mm")</time>
        </div>
        <div class="order-details-statuses">
            <span class="order-status-badge @orderStatusClass"><span class="order-status-dot"></span>@Model.Status</span>
            <span class="order-status-badge @paymentStatusClass"><span class="order-status-dot"></span>@(Model.PaymentStatus == PaymentStatus.Pending ? "Payment Pending" : Model.PaymentStatus.ToString())</span>
        </div>
    </header>

    <div class="order-details-grid">
        <main class="order-details-main">
            <section class="order-detail-block" aria-labelledby="shipping-heading">
                <div class="order-detail-block-heading">
                    <span>01</span>
                    <h2 id="shipping-heading">Shipping</h2>
                </div>
                <dl class="order-detail-data order-shipping-data">
                    <div><dt>Address</dt><dd>@Model.ShippingAddress</dd></div>
                    <div><dt>City</dt><dd>@Model.City</dd></div>
                    <div><dt>Phone</dt><dd>@Model.PhoneNumber</dd></div>
                </dl>
            </section>

            <section class="order-detail-block" aria-labelledby="products-heading">
                <div class="order-detail-block-heading">
                    <span>02</span>
                    <h2 id="products-heading">Products</h2>
                    <small>@itemCount @(itemCount == 1 ? "item" : "items")</small>
                </div>

                <div class="table-responsive order-details-table-wrap" tabindex="0">
                    <table class="table order-details-table align-middle mb-0">
                        <caption class="visually-hidden">Products included in order @Model.Id</caption>
                        <thead>
                            <tr>
                                <th scope="col">Product</th>
                                <th scope="col" class="text-end">Unit Price</th>
                                <th scope="col" class="text-center">Qty</th>
                                <th scope="col" class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td><strong class="order-product-name">@item.ProductName</strong></td>
                                    <td class="text-end text-nowrap">@item.UnitPrice.ToString("0.00") JD</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end text-nowrap fw-bold">@((item.UnitPrice * item.Quantity).ToString("0.00")) JD</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </main>

        <aside class="order-details-sidebar" aria-label="Order summary">
            <div class="order-summary-panel">
                <span class="orders-eyebrow">Summary</span>
                <h2>Order #@Model.Id</h2>
                <div class="order-summary-line"><span>Items</span><strong>@itemCount</strong></div>
                <div class="order-summary-line"><span>Status</span><strong>@Model.Status</strong></div>
                <div class="order-summary-line"><span>Payment</span><strong>@Model.PaymentStatus</strong></div>
                <div class="order-summary-total"><span>Total</span><strong>@Model.TotalAmount.ToString("0.00") JD</strong></div>
                <a asp-action="Invoice" asp-route-id="@Model.Id" class="btn btn-primary w-100">View Invoice</a>
                <a asp-action="Index" class="order-summary-back">Back to My Orders</a>
            </div>
        </aside>
    </div>
</div>
