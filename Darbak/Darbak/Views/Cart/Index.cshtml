@model List<Darbak.ViewModels.CartItemViewModel>

@{
    ViewData["Title"] = "Shopping Cart";

    var hasItems = Model != null && Model.Any();
    var itemCount = hasItems ? Model!.Sum(x => x.Quantity) : 0;
    var cartTotal = hasItems ? Model!.Sum(x => x.Total) : 0m;
}

<section class="cart-page">
    <div class="container">
        <nav class="darbak-breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li aria-hidden="true">/</li>
                <li aria-current="page">Cart</li>
            </ol>
        </nav>

        <header class="cart-page-header">
            <div class="cart-title-row">
                <div>
                    <span class="cart-page-kicker">Cart</span>
                    <h1>Shopping Cart</h1>
                </div>

                @if (hasItems)
                {
                    <span class="cart-item-count">
                        @itemCount @(itemCount == 1 ? "item" : "items")
                    </span>
                }
            </div>

            <a asp-controller="Catalog"
               asp-action="Index"
               class="cart-continue-link">
                Continue Shopping
                <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false">
                    <path d="m13.4 5.6-1.4 1.4 4 4H5v2h11l-4 4 1.4 1.4L19.8 12l-6.4-6.4Z" fill="currentColor" />
                </svg>
            </a>
        </header>

        @if (!hasItems)
        {
            <section class="cart-empty-state" aria-labelledby="empty-cart-title">
                <div class="cart-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="38" height="38" focusable="false">
                        <path d="M3 3h2.25l1.7 9.35A2 2 0 0 0 8.92 14h7.98a2 2 0 0 0 1.9-1.38L21 6H7.1l-.36-2H3V3Zm4.47 5H18.2l-1.35 4H8.92L7.47 8ZM9 16.5A1.5 1.5 0 1 0 9 19.5 1.5 1.5 0 0 0 9 16.5Zm8 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z" fill="currentColor" />
                    </svg>
                </div>
                <h2 id="empty-cart-title">Your cart is empty</h2>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-accent cart-empty-cta">
                    Shop Products
                </a>
            </section>
        }
        else
        {
            <div class="cart-layout">
                <section class="cart-items-panel" aria-labelledby="cart-items-title">
                    <div class="cart-panel-header">
                        <h2 id="cart-items-title">Products</h2>
                        <span>@itemCount total</span>
                    </div>

                    <div class="cart-items-list">
                        @foreach (var item in Model!)
                        {
                            <article class="cart-item">
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@item.ProductId"
                                   class="cart-item-media"
                                   aria-label="View @item.ProductName">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.ProductName"
                                             class="cart-item-image"
                                             loading="lazy"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <span class="cart-item-image-placeholder cart-item-image-fallback" aria-hidden="true">
                                            <span>DBK</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cart-item-image-placeholder" aria-hidden="true">
                                            <span>DBK</span>
                                        </span>
                                    }
                                </a>

                                <div class="cart-item-info">
                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@item.ProductId"
                                       class="cart-item-name">
                                        @item.ProductName
                                    </a>

                                    <span class="cart-item-unit-price">
                                        @item.Price.ToString("0.00") JD
                                    </span>

                                    <form asp-controller="Cart"
                                          asp-action="UpdateQuantity"
                                          method="post"
                                          class="cart-quantity-form">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <span class="cart-quantity-label">Quantity</span>

                                        <div class="cart-quantity-stepper"
                                             role="group"
                                             aria-label="Quantity for @item.ProductName">
                                            <button type="submit"
                                                    name="quantity"
                                                    value="@(item.Quantity - 1)"
                                                    class="cart-quantity-button"
                                                    aria-label="Decrease quantity of @item.ProductName"
                                                    title="Decrease quantity"
                                                    @(item.Quantity <= 1 ? "disabled" : null)>
                                                <span aria-hidden="true">−</span>
                                            </button>

                                            <output class="cart-quantity-value"
                                                    aria-live="polite">
                                                @item.Quantity
                                            </output>

                                            <button type="submit"
                                                    name="quantity"
                                                    value="@(item.Quantity + 1)"
                                                    class="cart-quantity-button"
                                                    aria-label="Increase quantity of @item.ProductName"
                                                    title="Increase quantity">
                                                <span aria-hidden="true">+</span>
                                            </button>
                                        </div>
                                    </form>
                                </div>

                                <div class="cart-item-side">
                                    <strong class="cart-item-total">@item.Total.ToString("0.00") JD</strong>

                                    <form asp-controller="Cart"
                                          asp-action="Remove"
                                          method="post"
                                          class="cart-remove-form"
                                          data-confirm
                                          data-confirm-title="Remove item?"
                                          data-confirm-message="Remove @item.ProductName from your cart?"
                                          data-confirm-button="Remove">
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button type="submit"
                                                class="cart-remove-button"
                                                aria-label="Remove @item.ProductName from cart"
                                                title="Remove">
                                            <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false">
                                                <path d="M7 21a2 2 0 0 1-2-2V7H4V5h4V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1h4v2h-1v12a2 2 0 0 1-2 2H7Zm9-14H7v12h10V7h-1ZM10 5h4V4h-4v1Zm0 11h2V9h-2v7Zm4 0h2V9h-2v7Z" fill="currentColor" />
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>

                    <div class="cart-panel-footer">
                        <a asp-controller="Catalog" asp-action="Index" class="cart-text-link">Continue Shopping</a>

                        <form asp-controller="Cart"
                              asp-action="Clear"
                              method="post"
                              data-confirm
                              data-confirm-title="Clear cart?"
                              data-confirm-message="Remove all items from your cart?"
                              data-confirm-button="Clear Cart">
                            <button type="submit"
                                    class="cart-clear-button">
                                Clear Cart
                            </button>
                        </form>
                    </div>
                </section>

                <aside class="cart-summary-card" aria-labelledby="cart-summary-title">
                    <div class="cart-summary-header">
                        <span class="cart-summary-kicker">Order</span>
                        <h2 id="cart-summary-title">Summary</h2>
                    </div>

                    <div class="cart-summary-lines">
                        <div class="cart-summary-line">
                            <span>Items</span>
                            <strong>@itemCount</strong>
                        </div>
                        <div class="cart-summary-line">
                            <span>Subtotal</span>
                            <strong>@cartTotal.ToString("0.00") JD</strong>
                        </div>
                    </div>

                    <div class="cart-summary-total">
                        <span>Total</span>
                        <strong>@cartTotal.ToString("0.00") JD</strong>
                    </div>

                    <a asp-controller="Orders"
                       asp-action="Checkout"
                       class="btn btn-accent cart-checkout-button">
                        Proceed to Checkout
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                            <path d="m13 5-1.41 1.41L16.17 11H4v2h12.17l-4.58 4.59L13 19l7-7-7-7Z" fill="currentColor" />
                        </svg>
                    </a>
                </aside>
            </div>
        }
    </div>
</section>
