@model List<Darbak.ViewModels.CartItemViewModel>

@{
    ViewData["Title"] = "Shopping Cart";

    var hasItems = Model != null && Model.Any();
    var itemCount = hasItems ? Model!.Sum(x => x.Quantity) : 0;
    var cartTotal = hasItems ? Model!.Sum(x => x.Total) : 0m;
}

<div class="cart-page">
    <div class="container">

        <nav class="darbak-breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li>
                    <a asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li aria-hidden="true">/</li>
                <li aria-current="page">Shopping Cart</li>
            </ol>
        </nav>

        <header class="cart-page-header">
            <div>
                <span class="cart-page-kicker">Your Order</span>
                <h1>Shopping Cart</h1>
                <p>
                    Review your products and quantities before continuing to checkout.
                </p>
            </div>

            <a asp-controller="Catalog"
               asp-action="Index"
               class="btn btn-outline-primary cart-continue-button">
                <svg viewBox="0 0 24 24"
                     width="18"
                     height="18"
                     aria-hidden="true"
                     focusable="false">
                    <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.42-1.41L7.83 13H20v-2Z"
                          fill="currentColor" />
                </svg>
                Continue Shopping
            </a>
        </header>

        @if (!hasItems)
        {
            <section class="cart-empty-state" aria-labelledby="empty-cart-title">
                <div class="cart-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"
                         width="42"
                         height="42"
                         focusable="false">
                        <path d="M3 3h2.25l1.7 9.35A2 2 0 0 0 8.92 14h7.98a2 2 0 0 0 1.9-1.38L21 6H7.1l-.36-2H3V3Zm4.47 5H18.2l-1.35 4H8.92L7.47 8ZM9 16.5A1.5 1.5 0 1 0 9 19.5 1.5 1.5 0 0 0 9 16.5Zm8 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z"
                              fill="currentColor" />
                    </svg>
                </div>

                <h2 id="empty-cart-title">Your cart is empty</h2>
                <p>
                    Browse the catalog and add the parts you need for your vehicle.
                </p>

                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-primary btn-lg">
                    Start Shopping
                </a>
            </section>
        }
        else
        {
            <div class="cart-layout">

                <section class="cart-items-panel" aria-labelledby="cart-items-title">
                    <div class="cart-panel-header">
                        <div>
                            <h2 id="cart-items-title">Cart Items</h2>
                            <p>
                                @itemCount @(itemCount == 1 ? "item" : "items") in your cart
                            </p>
                        </div>
                    </div>

                    <div class="cart-items-list">
                        @foreach (var item in Model!)
                        {
                            var quantityId = $"quantity-{item.ProductId}";

                            <article class="cart-item">
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@item.ProductId"
                                   class="cart-item-media"
                                   aria-label="View @item.ProductName">

                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.ProductName"
                                             class="cart-item-image"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="cart-item-image-placeholder" aria-hidden="true">
                                            <svg viewBox="0 0 24 24"
                                                 width="34"
                                                 height="34"
                                                 focusable="false">
                                                <path d="M4 4h16v16H4V4Zm2 2v8.59l3.5-3.5 2.5 2.5 2.5-2.5L18 14.59V6H6Zm0 12h12v-.59l-3.5-3.5-2.5 2.5-2.5-2.5L6 16.41V18Zm9-9a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"
                                                      fill="currentColor" />
                                            </svg>
                                        </span>
                                    }
                                </a>

                                <div class="cart-item-info">
                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@item.ProductId"
                                       class="cart-item-name">
                                        @item.ProductName
                                    </a>

                                    <span class="cart-item-unit-price">
                                        @item.Price.ToString("0.00") each
                                    </span>

                                    <form asp-controller="Cart"
                                          asp-action="UpdateQuantity"
                                          method="post"
                                          class="cart-quantity-form">

                                        <input type="hidden"
                                               name="productId"
                                               value="@item.ProductId" />

                                        <label for="@quantityId" class="cart-quantity-label">
                                            Quantity
                                        </label>

                                        <div class="cart-quantity-controls">
                                            <input type="number"
                                                   id="@quantityId"
                                                   name="quantity"
                                                   value="@item.Quantity"
                                                   min="1"
                                                   step="1"
                                                   inputmode="numeric"
                                                   class="form-control cart-quantity-input"
                                                   aria-label="Quantity for @item.ProductName" />

                                            <button type="submit"
                                                    class="btn btn-outline-primary cart-update-button">
                                                Update
                                            </button>
                                        </div>
                                    </form>
                                </div>

                                <div class="cart-item-totals">
                                    <span class="cart-item-total-label">Line Total</span>
                                    <strong class="cart-item-total">
                                        @item.Total.ToString("0.00")
                                    </strong>

                                    <form asp-controller="Cart"
                                          asp-action="Remove"
                                          method="post"
                                          class="cart-remove-form">
                                        <input type="hidden"
                                               name="productId"
                                               value="@item.ProductId" />

                                        <button type="submit"
                                                class="cart-remove-button"
                                                aria-label="Remove @item.ProductName from cart"
                                                onclick="return confirm('Remove this product from your cart?');">
                                            <svg viewBox="0 0 24 24"
                                                 width="17"
                                                 height="17"
                                                 aria-hidden="true"
                                                 focusable="false">
                                                <path d="M7 21a2 2 0 0 1-2-2V7H4V5h4V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v1h4v2h-1v12a2 2 0 0 1-2 2H7Zm9-14H7v12h10V7h-1ZM10 5h4V4h-4v1Zm0 11h2V9h-2v7Zm4 0h2V9h-2v7Z"
                                                      fill="currentColor" />
                                            </svg>
                                            Remove
                                        </button>
                                    </form>
                                </div>
                            </article>
                        }
                    </div>

                    <div class="cart-panel-footer">
                        <a asp-controller="Catalog"
                           asp-action="Index"
                           class="cart-text-link">
                            <svg viewBox="0 0 24 24"
                                 width="17"
                                 height="17"
                                 aria-hidden="true"
                                 focusable="false">
                                <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.42-1.41L7.83 13H20v-2Z"
                                      fill="currentColor" />
                            </svg>
                            Continue Shopping
                        </a>

                        <form asp-controller="Cart"
                              asp-action="Clear"
                              method="post">
                            <button type="submit"
                                    class="cart-clear-button"
                                    onclick="return confirm('Clear the entire cart?');">
                                Clear Cart
                            </button>
                        </form>
                    </div>
                </section>

                <aside class="cart-summary-card" aria-labelledby="cart-summary-title">
                    <div class="cart-summary-header">
                        <span class="cart-summary-kicker">Order Summary</span>
                        <h2 id="cart-summary-title">Summary</h2>
                    </div>

                    <div class="cart-summary-lines">
                        <div class="cart-summary-line">
                            <span>Items</span>
                            <strong>@itemCount</strong>
                        </div>

                        <div class="cart-summary-line">
                            <span>Subtotal</span>
                            <strong>@cartTotal.ToString("0.00")</strong>
                        </div>
                    </div>

                    <div class="cart-summary-total">
                        <span>Total</span>
                        <strong>@cartTotal.ToString("0.00")</strong>
                    </div>

                    <a asp-controller="Orders"
                       asp-action="Checkout"
                       class="btn btn-primary btn-lg cart-checkout-button">
                        Proceed to Checkout
                        <svg viewBox="0 0 24 24"
                             width="18"
                             height="18"
                             aria-hidden="true"
                             focusable="false">
                            <path d="m13 5-1.41 1.41L16.17 11H4v2h12.17l-4.58 4.59L13 19l7-7-7-7Z"
                                  fill="currentColor" />
                        </svg>
                    </a>

                    <p class="cart-summary-note">
                        Product availability and pricing are verified again before checkout.
                    </p>
                </aside>

            </div>
        }
    </div>
</div>
