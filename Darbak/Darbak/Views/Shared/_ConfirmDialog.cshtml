<div class="modal fade darbak-confirm-modal"
     id="darbakConfirmDialog"
     tabindex="-1"
     aria-labelledby="darbakConfirmTitle"
     aria-describedby="darbakConfirmMessage"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="darbak-confirm-accent" aria-hidden="true"></div>

            <div class="darbak-confirm-body">
                <div class="darbak-confirm-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="22" height="22" focusable="false">
                        <path d="M12 3.25 21 19H3l9-15.75Zm0 4.1-5.55 9.7h11.1L12 7.35Zm-1 2.4h2v4.4h-2v-4.4Zm0 5.55h2v2h-2v-2Z" fill="currentColor" />
                    </svg>
                </div>

                <div class="darbak-confirm-copy">
                    <span class="darbak-confirm-kicker">Confirm action</span>
                    <h2 id="darbakConfirmTitle">Are you sure?</h2>
                    <p id="darbakConfirmMessage">Please confirm this action.</p>
                </div>
            </div>

            <div class="darbak-confirm-actions">
                <button type="button"
                        class="darbak-confirm-button darbak-confirm-button--secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button"
                        class="darbak-confirm-button darbak-confirm-button--danger"
                        data-confirm-accept>
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>
