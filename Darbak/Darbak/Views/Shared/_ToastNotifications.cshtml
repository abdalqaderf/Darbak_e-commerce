@{
    var notificationDefinitions = new[]
    {
        new { Key = "CartSuccess", Type = "success", Title = "Cart updated" },
        new { Key = "CartError", Type = "danger", Title = "Cart error" },

        new { Key = "WishlistSuccess", Type = "success", Title = "Wishlist updated" },
        new { Key = "WishlistInfo", Type = "info", Title = "Wishlist" },
        new { Key = "WishlistError", Type = "danger", Title = "Wishlist error" },

        new { Key = "ReviewSuccess", Type = "success", Title = "Review submitted" },
        new { Key = "ReviewAdminSuccess", Type = "success", Title = "Review updated" },

        new { Key = "TestimonialSuccess", Type = "success", Title = "Testimonial updated" },

        new { Key = "CategorySuccess", Type = "success", Title = "Category updated" },
        new { Key = "CategoryError", Type = "danger", Title = "Category error" },

        new { Key = "ProductSuccess", Type = "success", Title = "Product updated" },
        new { Key = "ProductError", Type = "danger", Title = "Product error" },

        new { Key = "ImageSuccess", Type = "success", Title = "Product images updated" },
        new { Key = "ImageError", Type = "danger", Title = "Image error" },

        new { Key = "CheckoutInfo", Type = "info", Title = "Checkout" },

        new { Key = "PaymentInfo", Type = "info", Title = "Payment" },
        new { Key = "PaymentError", Type = "danger", Title = "Payment error" },

        new { Key = "OrderSuccess", Type = "success", Title = "Order updated" },
        new { Key = "OrderError", Type = "danger", Title = "Order error" },
        new { Key = "AdminOrderSuccess", Type = "success", Title = "Order updated" },

        new { Key = "UserSuccess", Type = "success", Title = "User updated" },
        new { Key = "UserInfo", Type = "info", Title = "User information" },
        new { Key = "UserError", Type = "danger", Title = "User error" }
    };

    var notifications = new List<(string Type, string Title, string Message)>();

    foreach (var definition in notificationDefinitions)
    {
        if (TempData[definition.Key] is string message &&
            !string.IsNullOrWhiteSpace(message))
        {
            notifications.Add((definition.Type, definition.Title, message));
        }
    }
}

@if (notifications.Any())
{
    <div class="toast-container darbak-toast-container position-fixed top-0 end-0 p-3"
         aria-label="Notifications">

        @foreach (var notification in notifications)
        {
            var isError = notification.Type == "danger";

            <div class="toast darbak-toast darbak-toast-@notification.Type"
                 role="@(isError ? "alert" : "status")"
                 aria-live="@(isError ? "assertive" : "polite")"
                 aria-atomic="true"
                 data-bs-autohide="true"
                 data-bs-delay="4500">

                <div class="darbak-toast-accent" aria-hidden="true"></div>

                <div class="darbak-toast-content">
                    <div class="darbak-toast-icon" aria-hidden="true"></div>

                    <div class="darbak-toast-copy">
                        <strong>@notification.Title</strong>
                        <p>@notification.Message</p>
                    </div>

                    <button type="button"
                            class="btn-close darbak-toast-close"
                            data-bs-dismiss="toast"
                            aria-label="Close notification">
                    </button>
                </div>
            </div>
        }
    </div>
}
