@model Darbak.ViewModels.HeaderCountsViewModel

<div class="site-commerce-actions">
    <a class="site-action site-action-with-badge"
       asp-area=""
       asp-controller="Wishlist"
       asp-action="Index"
       aria-label="Wishlist@(Model.WishlistCount > 0 ? $" ({Model.WishlistCount})" : string.Empty)"
       title="Wishlist">
        <svg class="site-action-icon" viewBox="0 0 24 24" width="21" height="21" aria-hidden="true" focusable="false">
            <path d="M12 20.6 4.2 13.4C2.7 12 2 10.4 2 8.7 2 5.6 4.3 3.5 7.2 3.5c1.9 0 3.6.9 4.8 2.4 1.2-1.5 2.9-2.4 4.8-2.4 2.9 0 5.2 2.1 5.2 5.2 0 1.7-.7 3.3-2.2 4.7L12 20.6Zm-4.8-15C5.3 5.6 4 6.8 4 8.7c0 1.1.5 2.2 1.6 3.2L12 17.8l6.4-5.9c1.1-1 1.6-2.1 1.6-3.2 0-1.9-1.3-3.1-3.2-3.1-1.7 0-3.1 1-3.9 2.7h-1.8c-.8-1.7-2.2-2.7-3.9-2.7Z" fill="currentColor" />
        </svg>
        @if (Model.WishlistCount > 0)
        {
            <span class="site-action-badge">@(Model.WishlistCount > 99 ? "99+" : Model.WishlistCount.ToString())</span>
        }
        <span class="visually-hidden">Wishlist</span>
    </a>

    <a class="site-action site-action-with-badge"
       asp-area=""
       asp-controller="Cart"
       asp-action="Index"
       aria-label="Shopping cart@(Model.CartCount > 0 ? $" ({Model.CartCount})" : string.Empty)"
       title="Cart">
        <svg class="site-action-icon" viewBox="0 0 24 24" width="21" height="21" aria-hidden="true" focusable="false">
            <path d="M3 3h2.15l1.82 9.2a2 2 0 0 0 1.96 1.6h7.92a2 2 0 0 0 1.9-1.37L21 6H7.1l-.4-2H3V3Zm4.5 5h10.73l-1.3 3.8h-8L7.5 8ZM9 16.5a1.55 1.55 0 1 0 0 3.1 1.55 1.55 0 0 0 0-3.1Zm8 0a1.55 1.55 0 1 0 0 3.1 1.55 1.55 0 0 0 0-3.1Z" fill="currentColor" />
        </svg>
        @if (Model.CartCount > 0)
        {
            <span class="site-action-badge">@(Model.CartCount > 99 ? "99+" : Model.CartCount.ToString())</span>
        }
        <span class="visually-hidden">Cart</span>
    </a>
</div>
