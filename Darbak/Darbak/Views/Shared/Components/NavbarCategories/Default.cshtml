@model IReadOnlyList<Darbak.Models.Category>

<li class="nav-item dropdown site-categories-nav">
    <button class="nav-link site-categories-toggle dropdown-toggle"
            type="button"
            id="categoriesDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false">
        Categories
    </button>

    <ul class="dropdown-menu site-categories-menu" aria-labelledby="categoriesDropdown">
        <li>
            <a class="dropdown-item site-categories-all"
               asp-area=""
               asp-controller="Catalog"
               asp-action="Index">
                All Categories
            </a>
        </li>

        @if (Model.Count > 0)
        {
            <li><hr class="dropdown-divider" /></li>

            @foreach (var category in Model)
            {
                <li>
                    <a class="dropdown-item"
                       asp-area=""
                       asp-controller="Catalog"
                       asp-action="Index"
                       asp-route-categoryId="@category.Id">
                        @category.Name
                    </a>
                </li>
            }
        }
    </ul>
</li>
