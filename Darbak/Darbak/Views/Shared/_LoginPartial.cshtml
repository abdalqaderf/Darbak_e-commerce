@using Darbak.Models
@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="dropdown site-account">

        <button class="site-action site-account-toggle dropdown-toggle"
                type="button"
                id="accountDropdown"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                aria-label="Open account menu">

            <svg class="site-action-icon"
                 viewBox="0 0 24 24"
                 width="22"
                 height="22"
                 aria-hidden="true"
                 focusable="false">
                <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-8a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm0 10c-4.4 0-8 2.25-8 5v2h16v-2c0-2.75-3.6-5-8-5Zm-6 5c.25-1.35 2.75-3 6-3s5.75 1.65 6 3H6Z"
                      fill="currentColor" />
            </svg>

            <span class="site-action-copy">
                <span class="site-action-kicker">Account</span>
                <span class="site-action-label site-account-name">
                    @User.Identity?.Name
                </span>
            </span>
        </button>

        <ul class="dropdown-menu dropdown-menu-end site-account-menu"
            aria-labelledby="accountDropdown">

            <li>
                <span class="dropdown-header site-account-email">
                    @User.Identity?.Name
                </span>
            </li>

            <li>
                <a class="dropdown-item"
                   asp-area="Identity"
                   asp-page="/Account/Manage/Index">
                    Manage Account
                </a>
            </li>

            <li>
                <a class="dropdown-item"
                   asp-area=""
                   asp-controller="Orders"
                   asp-action="Index">
                    My Orders
                </a>
            </li>

            @if (User.IsInRole("Admin"))
            {
                <li>
                    <a class="dropdown-item"
                       asp-area=""
                       asp-controller="AdminDashboard"
                       asp-action="Index">
                        Admin Dashboard
                    </a>
                </li>
            }

            <li><hr class="dropdown-divider" /></li>

            <li>
                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                      method="post"
                      class="m-0">

                    <button type="submit"
                            class="dropdown-item site-account-logout">
                        Sign Out
                    </button>
                </form>
            </li>

        </ul>
    </div>
}
else
{
    <div class="dropdown site-account">

        <button class="site-action site-account-toggle dropdown-toggle"
                type="button"
                id="accountDropdown"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                aria-label="Open account menu">

            <svg class="site-action-icon"
                 viewBox="0 0 24 24"
                 width="22"
                 height="22"
                 aria-hidden="true"
                 focusable="false">
                <path d="M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0-8a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm0 10c-4.4 0-8 2.25-8 5v2h16v-2c0-2.75-3.6-5-8-5Zm-6 5c.25-1.35 2.75-3 6-3s5.75 1.65 6 3H6Z"
                      fill="currentColor" />
            </svg>

            <span class="site-action-copy">
                <span class="site-action-kicker">Welcome</span>
                <span class="site-action-label">Account</span>
            </span>
        </button>

        <ul class="dropdown-menu dropdown-menu-end site-account-menu"
            aria-labelledby="accountDropdown">

            <li>
                <a class="dropdown-item"
                   asp-area="Identity"
                   asp-page="/Account/Login">
                    Sign In
                </a>
            </li>

            <li>
                <a class="dropdown-item"
                   asp-area="Identity"
                   asp-page="/Account/Register">
                    Create Account
                </a>
            </li>

        </ul>
    </div>
}
