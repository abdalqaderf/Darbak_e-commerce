@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isHome = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);

    var isShop = string.Equals(currentController, "Catalog", StringComparison.OrdinalIgnoreCase);

    var isAbout = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "About", StringComparison.OrdinalIgnoreCase);

    var isAdmin = User.IsInRole("Admin");
    var isIdentityArea = ViewData["IdentityArea"] is bool identityArea && identityArea;

    var currentSearch = isShop
        ? Context.Request.Query["search"].ToString()
        : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Darbak</title>

    <meta name="theme-color" content="#111827" />

    <link rel="icon" type="image/png" sizes="32x32" href="~/images/brand/favicon-32x32.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/brand/favicon-16x16.png" asp-append-version="true" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/brand/apple-touch-icon.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Darbak.styles.css"
          asp-append-version="true" />
</head>
<body class="site-shell d-flex flex-column min-vh-100 @(isIdentityArea ? "identity-context" : string.Empty)">

    <a class="skip-link" href="#main-content">
        Skip to main content
    </a>

    <header class="site-header">
        <div class="site-header-main">
            <div class="container">
                <div class="site-header-grid">

                    <a class="site-brand"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       aria-label="Darbak home">
                        <img src="~/images/brand/darbak-logo-horizontal.png"
                             alt="Darbak"
                             class="site-brand-logo" />
                    </a>

                    <nav class="site-navigation navbar navbar-expand-lg"
                         aria-label="Main navigation">
                        <div class="collapse navbar-collapse" id="siteNavigation">
                            <ul class="navbar-nav site-primary-nav">
                                <li class="nav-item">
                                    <a class="nav-link @(isHome ? "active" : string.Empty)"
                                       aria-current="@(isHome ? "page" : null)"
                                       asp-area=""
                                       asp-controller="Home"
                                       asp-action="Index">
                                        Home
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(isShop ? "active" : string.Empty)"
                                       aria-current="@(isShop ? "page" : null)"
                                       asp-area=""
                                       asp-controller="Catalog"
                                       asp-action="Index">
                                        Shop
                                    </a>
                                </li>
                                @await Component.InvokeAsync("NavbarCategories")
                                <li class="nav-item">
                                    <a class="nav-link @(isAbout ? "active" : string.Empty)"
                                       aria-current="@(isAbout ? "page" : null)"
                                       asp-area=""
                                       asp-controller="Home"
                                       asp-action="About">
                                        About Us
                                    </a>
                                </li>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <li class="nav-item d-lg-none">
                                        <a class="nav-link"
                                           asp-area=""
                                           asp-controller="Orders"
                                           asp-action="Index">
                                            My Orders
                                        </a>
                                    </li>
                                }
                                @if (isAdmin)
                                {
                                    <li class="nav-item site-admin-nav-item">
                                        <a class="nav-link"
                                           asp-area=""
                                           asp-controller="AdminDashboard"
                                           asp-action="Index">
                                            Admin
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </nav>

                    <div class="site-header-actions">
                        <div class="site-search-wrap">
                            <button class="site-action site-search-trigger"
                                    type="button"
                                    data-site-search-trigger
                                    aria-expanded="false"
                                    aria-controls="siteSearchPanel"
                                    aria-label="Open search"
                                    title="Search">
                                <svg class="site-action-icon"
                                     viewBox="0 0 24 24"
                                     width="20"
                                     height="20"
                                     aria-hidden="true"
                                     focusable="false">
                                    <path d="M10.8 4a6.8 6.8 0 1 0 4.28 12.08l4.42 4.42 1.42-1.42-4.42-4.42A6.8 6.8 0 0 0 10.8 4Zm0 2a4.8 4.8 0 1 1 0 9.6 4.8 4.8 0 0 1 0-9.6Z"
                                          fill="currentColor" />
                                </svg>
                            </button>

                            <form id="siteSearchPanel"
                                  class="site-search"
                                  data-site-search-panel
                                  asp-area=""
                                  asp-controller="Catalog"
                                  asp-action="Index"
                                  method="get"
                                  role="search"
                                  aria-label="Search products and categories">
                                <label class="visually-hidden" for="globalSearch">
                                    Search products or categories
                                </label>
                                <div class="site-search-box">
                                    <svg class="site-search-field-icon"
                                         viewBox="0 0 24 24"
                                         width="17"
                                         height="17"
                                         aria-hidden="true"
                                         focusable="false">
                                        <path d="M10.8 4a6.8 6.8 0 1 0 4.28 12.08l4.42 4.42 1.42-1.42-4.42-4.42A6.8 6.8 0 0 0 10.8 4Zm0 2a4.8 4.8 0 1 1 0 9.6 4.8 4.8 0 0 1 0-9.6Z"
                                              fill="currentColor" />
                                    </svg>
                                    <input id="globalSearch"
                                           class="site-search-input"
                                           type="search"
                                           name="search"
                                           value="@currentSearch"
                                           placeholder="Search products or categories..."
                                           autocomplete="off" />
                                    <button class="site-search-button"
                                            type="submit"
                                            aria-label="Submit search"
                                            title="Search">
                                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                                            <path d="M5 12h12.2l-4.6-4.6L14 6l7 7-7 7-1.4-1.4 4.6-4.6H5v-2Z" fill="currentColor" />
                                        </svg>
                                        <span class="visually-hidden">Search</span>
                                    </button>
                                </div>
                            </form>
                        </div>

                        @await Component.InvokeAsync("HeaderCounts")

                        <partial name="_LoginPartial" />
                    </div>

                    <button class="site-nav-toggler navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#siteNavigation"
                            aria-controls="siteNavigation"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span class="site-nav-toggler-lines" aria-hidden="true">
                            <span></span>
                            <span></span>
                            <span></span>
                        </span>
                    </button>

                </div>
            </div>
        </div>
    </header>

    <partial name="_ToastNotifications" />

    <main id="main-content"
          class="container flex-grow-1 @(isHome ? "home-main" : "py-4 py-lg-5")"
          role="main"
          tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer-main">
                <div class="site-footer-grid">

                    <div class="site-footer-intro">
                        <a class="site-footer-brand-visual"
                           asp-area=""
                           asp-controller="Home"
                           asp-action="Index"
                           aria-label="Darbak home">
                            <img src="~/images/brand/darbak-footer-car.jpeg"
                                 alt="Darbak automotive brand"
                                 class="site-footer-car-logo" />
                        </a>
                        <span class="site-footer-code">AUTO PARTS / ACCESSORIES</span>
                        <p class="site-footer-description">
                            Precision parts and accessories with clear product information,
                            stock visibility, and a direct path from browsing to checkout.
                        </p>
                    </div>

                    <div class="site-footer-group">
                        <h2 class="site-footer-heading">Explore</h2>
                        <ul class="site-footer-links">
                            <li><a asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li><a asp-area="" asp-controller="Catalog" asp-action="Index">Shop</a></li>
                            <li><a asp-area="" asp-controller="Home" asp-action="About">About Us</a></li>
                        </ul>
                    </div>

                    <div class="site-footer-group">
                        <h2 class="site-footer-heading">Shopping</h2>
                        <ul class="site-footer-links">
                            <li><a asp-area="" asp-controller="Cart" asp-action="Index">Cart</a></li>
                            <li><a asp-area="" asp-controller="Wishlist" asp-action="Index">Wishlist</a></li>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li><a asp-area="" asp-controller="Orders" asp-action="Index">My Orders</a></li>
                            }
                        </ul>
                    </div>

                    <div class="site-footer-group">
                        <h2 class="site-footer-heading">Account</h2>
                        <ul class="site-footer-links">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li>
                                    <a asp-area="Identity" asp-page="/Account/Manage/Index">Manage Account</a>
                                </li>
                                @if (isAdmin)
                                {
                                    <li>
                                        <a asp-area="" asp-controller="AdminDashboard" asp-action="Index">Admin Dashboard</a>
                                    </li>
                                }
                            }
                            else
                            {
                                <li><a asp-area="Identity" asp-page="/Account/Login">Sign In</a></li>
                                <li><a asp-area="Identity" asp-page="/Account/Register">Create Account</a></li>
                            }
                        </ul>
                    </div>

                </div>
            </div>

            <div class="site-footer-bottom">
                <p>&copy; @DateTime.Now.Year Darbak. All rights reserved.</p>
                <span class="site-footer-signature">DBK / PRECISION PARTS</span>
            </div>
        </div>
    </footer>

    <partial name="_ConfirmDialog" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
