@model ErrorViewModel
@{
    ViewData["Title"] = "Something Went Wrong";
}

<section class="system-state-page" aria-labelledby="error-title">
    <div class="system-state-card">
        <div class="system-state-code" aria-hidden="true">!</div>
        <span class="section-eyebrow">Darbak</span>
        <h1 id="error-title">Something went wrong</h1>
        <p>We could not complete the request. Return to the store and try again.</p>

        @if (Model.ShowRequestId)
        {
            <p class="system-state-request">
                <strong>Request ID:</strong>
                <code>@Model.RequestId</code>
            </p>
        }

        <div class="system-state-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary">Browse Products</a>
        </div>
    </div>
</section>
