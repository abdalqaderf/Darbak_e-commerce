@model Darbak.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<section class="home-hero" aria-labelledby="homeHeroTitle">
    <div class="home-hero-grid">
        <div class="home-hero-content">
            <span class="home-eyebrow">Darbak Auto Parts</span>

            <h1 id="homeHeroTitle" class="home-hero-title">
                Performance That
                <span>Drives You</span>
            </h1>

            <p class="home-hero-subtitle">
                Find the parts and accessories you need with clear product details,
                real stock visibility, and a straightforward shopping experience.
            </p>

            <div class="home-hero-actions">
                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-accent btn-lg">
                    Shop Now
                </a>

                <a href="#shop-by-category"
                   class="btn btn-hero-secondary btn-lg">
                    Browse Categories
                </a>
            </div>

            <div class="home-hero-note">
                <span class="home-hero-note-dot" aria-hidden="true"></span>
                Browse active products currently available in the Darbak catalog.
            </div>
        </div>

        <div class="home-hero-visual" aria-hidden="true">
            <div class="home-hero-ring home-hero-ring-one"></div>
            <div class="home-hero-ring home-hero-ring-two"></div>

            <svg class="home-car-art"
                 viewBox="0 0 640 320"
                 role="img"
                 focusable="false">
                <path class="home-car-shadow"
                      d="M97 249c0-14 57-26 223-26s223 12 223 26-57 25-223 25S97 263 97 249Z" />
                <path class="home-car-body"
                      d="M89 213c8-25 21-45 47-58l66-27c25-42 60-67 110-71h83c47 3 86 27 121 72l56 16c27 8 43 25 49 52l5 26H89v-10Z" />
                <path class="home-car-window"
                      d="M235 125c22-31 47-47 82-50h66c35 2 63 19 90 51l-238-1Z" />
                <path class="home-car-detail"
                      d="M151 156h59m247 0h58M278 151h76m-148 44h272" />
                <circle class="home-car-wheel" cx="195" cy="222" r="45" />
                <circle class="home-car-wheel-inner" cx="195" cy="222" r="19" />
                <circle class="home-car-wheel" cx="497" cy="222" r="45" />
                <circle class="home-car-wheel-inner" cx="497" cy="222" r="19" />
                <path class="home-car-accent"
                      d="M90 214h60m393 0h82M411 129h103" />
            </svg>
        </div>
    </div>
</section>

<section class="home-trust-section" aria-label="Shopping highlights">
    <div class="home-trust-grid">
        <article class="home-trust-item">
            <span class="home-trust-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M12 2.7 19 6v5.2c0 4.5-2.9 8.5-7 10.1-4.1-1.6-7-5.6-7-10.1V6l7-3.3Zm0 2.2L7 7.2v4c0 3.4 2 6.5 5 7.9 3-1.4 5-4.5 5-7.9v-4l-5-2.3Zm-1 9.5-2.5-2.5 1.4-1.4 1.1 1.1 3.3-3.3 1.4 1.4-4.7 4.7Z" />
                </svg>
            </span>
            <span>
                <strong>Clear Product Information</strong>
                <small>Product details, pricing, and availability at a glance.</small>
            </span>
        </article>

        <article class="home-trust-item">
            <span class="home-trust-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M17 8h-1V6a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2Zm-7-2a2 2 0 1 1 4 0v2h-4V6Zm7 13H7v-9h10v9Zm-6-6h2v3h-2v-3Z" />
                </svg>
            </span>
            <span>
                <strong>Secure Checkout</strong>
                <small>Checkout is protected behind account authentication.</small>
            </span>
        </article>

        <article class="home-trust-item">
            <span class="home-trust-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M4 4h2.2l1.2 3H20l-2.2 7.1a2 2 0 0 1-1.9 1.4H9.2a2 2 0 0 1-1.9-1.4L4 6V4Zm4.2 5 1.7 4.5h6l1.4-4.5H8.2ZM10 17a2 2 0 1 1 0 4 2 2 0 0 1 0-4Zm6 0a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z" />
                </svg>
            </span>
            <span>
                <strong>Easy Shopping</strong>
                <small>Add products to your cart and manage quantities easily.</small>
            </span>
        </article>

        <article class="home-trust-item">
            <span class="home-trust-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                    <path d="m12 2.5 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5-5.8-3.1-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2.5Zm0 4.5-1.6 3.2-3.6.5 2.6 2.5-.6 3.6 3.2-1.7 3.2 1.7-.6-3.6 2.6-2.5-3.6-.5L12 7Z" />
                </svg>
            </span>
            <span>
                <strong>Customer Reviews</strong>
                <small>Approved ratings help you evaluate products before buying.</small>
            </span>
        </article>
    </div>
</section>

<section id="shop-by-category" class="home-section" aria-labelledby="categoryTitle">
    <div class="home-section-heading">
        <div>
            <span class="home-section-kicker">Find your next part</span>
            <h2 id="categoryTitle">Shop by Category</h2>
            <p>Browse the categories currently available in the Darbak catalog.</p>
        </div>

        <a asp-controller="Catalog"
           asp-action="Index"
           class="home-text-link">
            View all products
            <span aria-hidden="true">→</span>
        </a>
    </div>

    @if (!Model.Categories.Any())
    {
        <div class="home-empty-state">
            <span class="home-empty-icon" aria-hidden="true">⌁</span>
            <h3>No categories yet</h3>
            <p>Categories will appear here when they become available.</p>
        </div>
    }
    else
    {
        <div class="home-category-grid">
            @foreach (var category in Model.Categories)
            {
                <a asp-controller="Catalog"
                   asp-action="Index"
                   asp-route-categoryId="@category.Id"
                   class="home-category-card">
                    <span class="home-category-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                            <path d="M4 5h7v6H4V5Zm9 0h7v6h-7V5ZM4 13h7v6H4v-6Zm9 0h7v6h-7v-6ZM6 7v2h3V7H6Zm9 0v2h3V7h-3Zm-9 8v2h3v-2H6Zm9 0v2h3v-2h-3Z" />
                        </svg>
                    </span>

                    <span class="home-category-content">
                        <strong>@category.Name</strong>

                        @if (!string.IsNullOrWhiteSpace(category.Description))
                        {
                            <small>@category.Description</small>
                        }
                        else
                        {
                            <small>Explore products in this category.</small>
                        }
                    </span>

                    <span class="home-category-meta">
                        @category.ProductCount
                        @(category.ProductCount == 1 ? "product" : "products")
                    </span>

                    <span class="home-category-arrow" aria-hidden="true">→</span>
                </a>
            }
        </div>
    }
</section>

<section class="home-section" aria-labelledby="featuredProductsTitle">
    <div class="home-section-heading">
        <div>
            <span class="home-section-kicker">Latest arrivals</span>
            <h2 id="featuredProductsTitle">Featured Products</h2>
            <p>Explore some of the newest active products in the Darbak catalog.</p>
        </div>

        <a asp-controller="Catalog"
           asp-action="Index"
           class="home-text-link">
            Shop all products
            <span aria-hidden="true">→</span>
        </a>
    </div>

    @if (!Model.LatestProducts.Any())
    {
        <div class="home-empty-state">
            <span class="home-empty-icon" aria-hidden="true">⌁</span>
            <h3>No products available</h3>
            <p>Active products will appear here when they are added.</p>
        </div>
    }
    else
    {
        <div class="home-product-grid">
            @foreach (var product in Model.LatestProducts)
            {
                <article class="home-product-card">
                    <div class="home-product-media">
                        <a asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@product.Id"
                           class="home-product-image-link"
                           aria-label="View @product.Name">

                            @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                            {
                                <img src="@product.MainImageUrl"
                                     alt="@product.Name"
                                     class="home-product-image"
                                     loading="lazy" />
                            }
                            else
                            {
                                <span class="home-product-placeholder" aria-hidden="true">
                                    <svg viewBox="0 0 64 64" focusable="false">
                                        <path d="M13 38h5l4-10c1.5-4 5-7 9.5-7h10c4 0 7.5 2.2 9.3 5.8L56 38h2a3 3 0 0 1 3 3v8h-5a8 8 0 0 1-16 0H25a8 8 0 0 1-16 0H4v-5c0-3.3 2.7-6 6-6h3Zm12.5-8L22 38h29l-3.8-8.2a6 6 0 0 0-5.4-3.5H31.5a6.5 6.5 0 0 0-6 3.7ZM17 45a4 4 0 1 0 0 8 4 4 0 0 0 0-8Zm31 0a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z" />
                                    </svg>
                                    <small>No image available</small>
                                </span>
                            }
                        </a>

                        <div class="home-product-stock">
                            @if (product.StockQuantity > 0)
                            {
                                <span class="badge bg-success">In Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Out of Stock</span>
                            }
                        </div>

                        <div class="home-product-wishlist">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Wishlist"
                                      asp-action="Add"
                                      method="post">
                                    <input type="hidden"
                                           name="productId"
                                           value="@product.Id" />

                                    <button type="submit"
                                            class="home-icon-button"
                                            aria-label="Add @product.Name to wishlist"
                                            title="Add to wishlist">
                                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                            <path d="M12 20.7 10.6 19.4C5.4 14.8 2 11.7 2 7.9 2 4.8 4.4 2.5 7.5 2.5c1.8 0 3.5.8 4.5 2.1 1-1.3 2.7-2.1 4.5-2.1C19.6 2.5 22 4.8 22 7.9c0 3.8-3.4 6.9-8.6 11.5L12 20.7Zm4.5-16.2c-1.6 0-3.1.8-4 2.1h-1c-.9-1.3-2.4-2.1-4-2.1C5.5 4.5 4 6 4 7.9c0 2.8 2.8 5.5 8 10.1 5.2-4.6 8-7.3 8-10.1 0-1.9-1.5-3.4-3.5-3.4Z" />
                                        </svg>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-area="Identity"
                                   asp-page="/Account/Login"
                                   class="home-icon-button"
                                   aria-label="Sign in to save @product.Name to wishlist"
                                   title="Sign in to save">
                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                        <path d="M12 20.7 10.6 19.4C5.4 14.8 2 11.7 2 7.9 2 4.8 4.4 2.5 7.5 2.5c1.8 0 3.5.8 4.5 2.1 1-1.3 2.7-2.1 4.5-2.1C19.6 2.5 22 4.8 22 7.9c0 3.8-3.4 6.9-8.6 11.5L12 20.7Zm4.5-16.2c-1.6 0-3.1.8-4 2.1h-1c-.9-1.3-2.4-2.1-4-2.1C5.5 4.5 4 6 4 7.9c0 2.8 2.8 5.5 8 10.1 5.2-4.6 8-7.3 8-10.1 0-1.9-1.5-3.4-3.5-3.4Z" />
                                    </svg>
                                </a>
                            }
                        </div>
                    </div>

                    <div class="home-product-body">
                        <div class="home-product-category">@product.CategoryName</div>

                        <h3 class="home-product-name">
                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id">
                                @product.Name
                            </a>
                        </h3>

                        <div class="home-product-rating">
                            @if (product.ReviewCount > 0)
                            {
                                <span class="home-rating-star" aria-hidden="true">★</span>
                                <strong>@product.AverageRating.ToString("0.0")</strong>
                                <span class="home-review-count">
                                    (@product.ReviewCount @(product.ReviewCount == 1 ? "review" : "reviews"))
                                </span>
                            }
                            else
                            {
                                <span class="home-review-count">No reviews yet</span>
                            }
                        </div>

                        <div class="home-product-footer">
                            <div class="home-product-price">
                                <span class="visually-hidden">Price:</span>
                                @product.Price.ToString("0.00")
                            </div>

                            @if (product.StockQuantity > 0)
                            {
                                <form asp-controller="Cart"
                                      asp-action="AddToCart"
                                      method="post">
                                    <input type="hidden"
                                           name="productId"
                                           value="@product.Id" />

                                    <button type="submit"
                                            class="btn btn-accent home-add-cart-button">
                                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                            <path d="M3 3h2.2l1.7 9.3a2 2 0 0 0 2 1.7h8a2 2 0 0 0 1.9-1.4L21 6H7.1l-.4-2H3V3Zm4.5 5h10.7l-1.4 4H8.9L7.5 8ZM9 16.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm8 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z" />
                                        </svg>
                                        Add to Cart
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-outline-secondary home-add-cart-button">
                                    View Details
                                </a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="home-testimonials" aria-labelledby="testimonialsTitle">
    <div class="home-section-heading home-section-heading-light">
        <div>
            <span class="home-section-kicker">Customer feedback</span>
            <h2 id="testimonialsTitle">What Our Customers Say</h2>
            <p>Recent testimonials that have been approved for public display.</p>
        </div>

        <a asp-controller="Testimonials"
           asp-action="Index"
           class="home-text-link home-text-link-light">
            View all testimonials
            <span aria-hidden="true">→</span>
        </a>
    </div>

    @if (!Model.Testimonials.Any())
    {
        <div class="home-empty-state home-empty-state-dark">
            <h3>No testimonials yet</h3>
            <p>Approved customer testimonials will appear here.</p>
        </div>
    }
    else
    {
        <div class="home-testimonial-grid">
            @foreach (var testimonial in Model.Testimonials)
            {
                <article class="home-testimonial-card">
                    <span class="home-quote-mark" aria-hidden="true">“</span>

                    <p class="home-testimonial-copy">
                        @testimonial.Content
                    </p>

                    <footer class="home-testimonial-author">
                        <span class="home-testimonial-avatar" aria-hidden="true">
                            @(string.IsNullOrWhiteSpace(testimonial.UserName)
                                ? "U"
                                : testimonial.UserName.Substring(0, 1).ToUpperInvariant())
                        </span>

                        <span>
                            <strong>@testimonial.UserName</strong>
                            <small>@testimonial.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                        </span>
                    </footer>
                </article>
            }
        </div>
    }
</section>

<section class="home-bottom-cta" aria-labelledby="bottomCtaTitle">
    <div>
        <span class="home-section-kicker">Keep moving forward</span>
        <h2 id="bottomCtaTitle">Ready to Upgrade Your Ride?</h2>
        <p>Explore the Darbak catalog and find the right products for your next upgrade.</p>
    </div>

    <a asp-controller="Catalog"
       asp-action="Index"
       class="btn btn-accent btn-lg">
        Shop Now
    </a>
</section>
