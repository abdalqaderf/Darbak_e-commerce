@model Darbak.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
    var currentReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var homeCategories = Model.Categories.ToList();
    var featuredProducts = Model.LatestProducts.Take(4).ToList();
    var offerProduct = Model.LatestProducts
        .FirstOrDefault(product => product.StockQuantity > 0 && featuredProducts.All(featured => featured.Id != product.Id))
        ?? Model.LatestProducts.FirstOrDefault(product => product.StockQuantity > 0);
    var homeTestimonials = Model.Testimonials.Take(3).ToList();
}

<section class="home-hero" aria-labelledby="homeHeroTitle">
    <div class="home-hero-visual" aria-hidden="true">
        <span class="home-hero-image-fallback">DBK</span>
        <img src="~/images/home/Hero_photo.png"
             alt=""
             class="home-hero-image"
             asp-append-version="true"
             onerror="this.hidden=true" />
    </div>

    <div class="home-hero-shade" aria-hidden="true"></div>

    <div class="home-hero-inner">
        <div class="home-hero-content">
            <span class="home-eyebrow">Darbak / Auto Parts &amp; Accessories</span>

            <h1 id="homeHeroTitle" class="home-hero-title">
                Precision parts.<br />
                Built for the road.
            </h1>

            <p class="home-hero-subtitle">
                Find parts and accessories with clear product details, live stock visibility, and a straightforward path from browsing to checkout.
            </p>

            <div class="home-hero-actions">
                <a asp-controller="Catalog"
                   asp-action="Index"
                   class="btn btn-accent home-hero-primary">
                    Shop Parts
                    <span aria-hidden="true">→</span>
                </a>

                <a href="#shop-by-category"
                   class="btn home-hero-secondary">
                    Browse Categories
                </a>
            </div>
        </div>
    </div>

    <div class="home-hero-benefits" aria-label="Darbak shopping features">
        <div class="home-hero-benefits-inner">
            <div class="home-hero-benefit">
                <span class="home-hero-benefit-index">01</span>
                <div>
                    <strong>Fast Search</strong>
                    <small>Products &amp; categories</small>
                </div>
            </div>

            <div class="home-hero-benefit">
                <span class="home-hero-benefit-index">02</span>
                <div>
                    <strong>Stock Visibility</strong>
                    <small>Check before checkout</small>
                </div>
            </div>

            <div class="home-hero-benefit">
                <span class="home-hero-benefit-index">03</span>
                <div>
                    <strong>Guest Cart</strong>
                    <small>Keep items while browsing</small>
                </div>
            </div>

            <div class="home-hero-benefit">
                <span class="home-hero-benefit-index">04</span>
                <div>
                    <strong>Order History</strong>
                    <small>Current &amp; previous orders</small>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="shop-by-category" class="home-section home-categories-section" aria-labelledby="categoryTitle">
    <div class="home-line-heading home-line-heading--categories">
        <div class="home-line-heading-title">
            <h2 id="categoryTitle">Shop by Category</h2>
            <span aria-hidden="true"></span>
        </div>
    </div>

    @if (!homeCategories.Any())
    {
        <div class="home-empty-state">
            <strong>No categories yet</strong>
            <span>Categories will appear here when they become available.</span>
        </div>
    }
    else
    {
        <div class="home-category-mosaic">
            @for (var i = 0; i < homeCategories.Count; i++)
            {
                var category = homeCategories[i];
                var tileClass = i switch
                {
                    0 => "home-category-card home-category-card--feature",
                    1 => "home-category-card home-category-card--medium",
                    2 => "home-category-card home-category-card--small",
                    3 => "home-category-card home-category-card--small",
                    4 => "home-category-card home-category-card--medium",
                    _ => "home-category-card home-category-card--standard"
                };

                <a asp-controller="Catalog"
                   asp-action="Index"
                   asp-route-categoryId="@category.Id"
                   class="@tileClass">

                    <div class="home-category-copy">
                        <span class="home-category-number">@((i + 1).ToString("00"))</span>
                        <strong>@category.Name</strong>

                        @if (!string.IsNullOrWhiteSpace(category.Description))
                        {
                            <small>@category.Description</small>
                        }
                        else
                        {
                            <small>@category.ProductCount @(category.ProductCount == 1 ? "product" : "products") available</small>
                        }

                        <span class="home-category-arrow" aria-hidden="true">→</span>
                    </div>

                    <span class="home-category-technical" aria-hidden="true">DBK</span>

                    @if (!string.IsNullOrWhiteSpace(category.ImageUrl))
                    {
                        <img src="@category.ImageUrl"
                             alt=""
                             class="home-category-image"
                             loading="lazy"
                             onerror="this.hidden=true" />
                    }
                </a>
            }
        </div>
    }
</section>

<section class="home-section home-products-section" aria-labelledby="featuredProductsTitle">
    <div class="home-line-heading">
        <div class="home-line-heading-title">
            <h2 id="featuredProductsTitle">Featured Products</h2>
            <span aria-hidden="true"></span>
        </div>

        <a asp-controller="Catalog"
           asp-action="Index"
           class="home-line-link">
            View all products
            <span aria-hidden="true">→</span>
        </a>
    </div>

    @if (!featuredProducts.Any())
    {
        <div class="home-empty-state">
            <strong>No products available</strong>
            <span>Active products will appear here when they are added.</span>
        </div>
    }
    else
    {
        <div class="home-product-rail">
            @foreach (var product in featuredProducts)
            {
                <article class="home-product-card">
                    <div class="home-product-media">
                        <a asp-controller="Products"
                           asp-action="Details"
                           asp-route-id="@product.Id"
                           class="home-product-image-link"
                           aria-label="View @product.Name">

                            <span class="home-product-placeholder" aria-hidden="true">
                                <strong>DBK</strong>
                                <small>No image</small>
                            </span>

                            @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                            {
                                <img src="@product.MainImageUrl"
                                     alt="@product.Name"
                                     class="home-product-image"
                                     loading="lazy"
                                     onerror="this.hidden=true" />
                            }
                        </a>

                        <div class="home-product-wishlist">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Wishlist"
                                      asp-action="Add"
                                      method="post">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit"
                                            class="home-icon-button"
                                            aria-label="Add @product.Name to wishlist"
                                            title="Add to wishlist">
                                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                            <path d="M12 20.7 10.6 19.4C5.4 14.8 2 11.7 2 7.9 2 4.8 4.4 2.5 7.5 2.5c1.8 0 3.5.8 4.5 2.1 1-1.3 2.7-2.1 4.5-2.1C19.6 2.5 22 4.8 22 7.9c0 3.8-3.4 6.9-8.6 11.5L12 20.7Zm4.5-16.2c-1.6 0-3.1.8-4 2.1h-1c-.9-1.3-2.4-2.1-4-2.1C5.5 4.5 4 6 4 7.9c0 2.8 2.8 5.5 8 10.1 5.2-4.6 8-7.3 8-10.1 0-1.9-1.5-3.4-3.5-3.4Z" />
                                        </svg>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-area="Identity"
                                   asp-page="/Account/Login"
                                   class="home-icon-button"
                                   aria-label="Sign in to save @product.Name to wishlist"
                                   title="Sign in to save">
                                    <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                        <path d="M12 20.7 10.6 19.4C5.4 14.8 2 11.7 2 7.9 2 4.8 4.4 2.5 7.5 2.5c1.8 0 3.5.8 4.5 2.1 1-1.3 2.7-2.1 4.5-2.1C19.6 2.5 22 4.8 22 7.9c0 3.8-3.4 6.9-8.6 11.5L12 20.7Zm4.5-16.2c-1.6 0-3.1.8-4 2.1h-1c-.9-1.3-2.4-2.1-4-2.1C5.5 4.5 4 6 4 7.9c0 2.8 2.8 5.5 8 10.1 5.2-4.6 8-7.3 8-10.1 0-1.9-1.5-3.4-3.5-3.4Z" />
                                    </svg>
                                </a>
                            }
                        </div>
                    </div>

                    <div class="home-product-body">
                        <span class="home-product-category">@product.CategoryName</span>

                        <h3 class="home-product-name">
                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id">
                                @product.Name
                            </a>
                        </h3>

                        <div class="home-product-meta-row">
                            <span class="home-product-rating @(product.ReviewCount == 0 ? "home-product-rating--empty" : "")">
                                @if (product.ReviewCount > 0)
                                {
                                    <span aria-hidden="true">★</span>
                                    <strong>@product.AverageRating.ToString("0.0")</strong>
                                    <small>(@product.ReviewCount)</small>
                                }
                                else
                                {
                                    <small>No reviews</small>
                                }
                            </span>

                            <span class="@(product.StockQuantity > 0 ? "home-stock home-stock--in" : "home-stock home-stock--out")">
                                @(product.StockQuantity > 0 ? "In stock" : "Out of stock")
                            </span>
                        </div>

                        <div class="home-product-footer">
                            <strong class="home-product-price">@product.Price.ToString("0.00") JD</strong>

                            @if (product.StockQuantity > 0)
                            {
                                <form asp-controller="Cart"
                                      asp-action="AddToCart"
                                      method="post">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="returnUrl" value="@currentReturnUrl" />
                                    <button type="submit"
                                            class="home-cart-icon-button"
                                            aria-label="Add @product.Name to cart"
                                            title="Add to cart">
                                        <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
                                            <path d="M3 3h2.2l1.7 9.3a2 2 0 0 0 2 1.7h8a2 2 0 0 0 1.9-1.4L21 6H7.1l-.4-2H3V3Zm4.5 5h10.7l-1.4 4H8.9L7.5 8ZM9 16.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm8 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z" />
                                        </svg>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="home-cart-icon-button"
                                   aria-label="View @product.Name details"
                                   title="View details">
                                    <span aria-hidden="true">→</span>
                                </a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="home-section home-offers-section" aria-labelledby="offersTitle">
    <div class="home-offers-frame">
        <div class="home-offers-copy">
            <span class="home-offers-kicker">Darbak / Offers</span>
            <h2 id="offersTitle">A current pick, without the noise.</h2>
            <p>
                One in-stock product highlighted from the live catalog. Price and stock come directly from the product data.
            </p>

            <a asp-controller="Catalog"
               asp-action="Index"
               class="home-offers-button">
                Browse all products
                <span aria-hidden="true">→</span>
            </a>

            <span class="home-offers-note">Live catalog selection</span>
        </div>

        @if (offerProduct is not null)
        {
            <a asp-controller="Products"
               asp-action="Details"
               asp-route-id="@offerProduct.Id"
               class="home-offer-feature">

                <div class="home-offer-media">
                    <span class="home-offer-image-fallback" aria-hidden="true">DBK</span>

                    @if (!string.IsNullOrWhiteSpace(offerProduct.MainImageUrl))
                    {
                        <img src="@offerProduct.MainImageUrl"
                             alt="@offerProduct.Name"
                             loading="lazy"
                             onerror="this.hidden=true" />
                    }
                </div>

                <div class="home-offer-info">
                    <div class="home-offer-topline">
                        <span>@offerProduct.CategoryName</span>
                        <span>In stock</span>
                    </div>

                    <h3>@offerProduct.Name</h3>

                    <div class="home-offer-price-row">
                        <strong>@offerProduct.Price.ToString("0.00") JD</strong>
                        <small>@offerProduct.StockQuantity available</small>
                    </div>

                    <span class="home-offer-view">
                        View product
                        <span aria-hidden="true">↗</span>
                    </span>
                </div>
            </a>
        }
        else
        {
            <div class="home-offer-empty">
                <strong>No in-stock highlight yet.</strong>
                <span>An available product will appear here automatically.</span>
            </div>
        }
    </div>
</section>

<section class="home-section home-why-section" aria-labelledby="whyDarbakTitle">
    <div class="home-line-heading">
        <div class="home-line-heading-title">
            <h2 id="whyDarbakTitle">Why Darbak</h2>
            <span aria-hidden="true"></span>
        </div>
    </div>

    <div class="home-why-composition">
        <div class="home-why-intro">
            <span class="home-why-kicker">Darbak / Shopping flow</span>
            <h3>Less guessing. More control.</h3>
            <p>
                The storefront keeps the information that matters close to the buying decision, from product discovery through orders.
            </p>
            <a asp-controller="Catalog"
               asp-action="Index"
               class="home-why-link">
                Explore the catalog
                <span aria-hidden="true">→</span>
            </a>
        </div>

        <div class="home-why-list">
            <div class="home-why-item">
                <span>01</span>
                <div>
                    <strong>Clear Product Data</strong>
                    <small>Product details, pricing, and stock stay visible while you shop.</small>
                </div>
            </div>

            <div class="home-why-item">
                <span>02</span>
                <div>
                    <strong>Guest-Friendly Cart</strong>
                    <small>Add and manage cart items before signing in for checkout.</small>
                </div>
            </div>

            <div class="home-why-item">
                <span>03</span>
                <div>
                    <strong>Moderated Feedback</strong>
                    <small>Public reviews and testimonials appear after approval.</small>
                </div>
            </div>

            <div class="home-why-item">
                <span>04</span>
                <div>
                    <strong>Order Visibility</strong>
                    <small>Review current and previous orders from your account.</small>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="home-section home-testimonials" aria-labelledby="testimonialsTitle">
    <div class="home-line-heading">
        <div class="home-line-heading-title">
            <h2 id="testimonialsTitle">What Customers Say</h2>
            <span aria-hidden="true"></span>
        </div>

        @if (homeTestimonials.Any())
        {
            <a asp-controller="Testimonials"
               asp-action="Index"
               class="home-line-link">
                See all testimonials
                <span aria-hidden="true">→</span>
            </a>
        }
    </div>

    @if (!homeTestimonials.Any())
    {
        <div class="home-testimonial-empty">
            <div>
                <strong>No approved testimonials yet.</strong>
                <span>Customer feedback will appear here after moderation.</span>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Testimonials" asp-action="Create">Share your experience →</a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login">Sign in to share →</a>
            }
        </div>
    }
    else
    {
        var featuredTestimonial = homeTestimonials[0];
        var supportingTestimonials = homeTestimonials.Skip(1).ToList();

        <div class="home-testimonial-composition @(supportingTestimonials.Any() ? string.Empty : "home-testimonial-composition--single")">
            <article class="home-testimonial-feature">
                <span class="home-testimonial-quote" aria-hidden="true">“</span>
                <p>@featuredTestimonial.Content</p>
                <footer>
                    <strong>@featuredTestimonial.UserName</strong>
                    <time datetime="@featuredTestimonial.CreatedAt.ToString("yyyy-MM-dd")">
                        @featuredTestimonial.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                    </time>
                </footer>
            </article>

            @if (supportingTestimonials.Any())
            {
                <div class="home-testimonial-supporting">
                    @foreach (var testimonial in supportingTestimonials)
                    {
                        <article class="home-testimonial-card">
                            <p>@testimonial.Content</p>
                            <footer>
                                <strong>@testimonial.UserName</strong>
                                <time datetime="@testimonial.CreatedAt.ToString("yyyy-MM-dd")">
                                    @testimonial.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                </time>
                            </footer>
                        </article>
                    }
                </div>
            }
        </div>
    }
</section>

<section class="home-bottom-cta" aria-labelledby="bottomCtaTitle">
    <div class="home-bottom-cta-inner">
        <div class="home-bottom-cta-copy">
            <span>Darbak / Catalog</span>
            <div>
                <h2 id="bottomCtaTitle">Ready to find your part?</h2>
                <p>Browse the catalog and move directly to the products you need.</p>
            </div>
        </div>

        <a asp-controller="Catalog"
           asp-action="Index"
           class="btn home-bottom-cta-button">
            Shop Now
            <span aria-hidden="true">→</span>
        </a>
    </div>
</section>

