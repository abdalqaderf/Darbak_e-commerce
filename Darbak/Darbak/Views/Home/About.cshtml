@model Darbak.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "About Us";
    var featuredTestimonial = Model.Testimonials.FirstOrDefault();
    var supportingTestimonials = Model.Testimonials.Skip(1).Take(2).ToList();
}

<nav class="darbak-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="Home" asp-action="Index">Home</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">About Us</span>
</nav>

<div class="about-page about-page--refined">
    <section class="about-hero about-hero--photo" aria-labelledby="about-title">
        <div class="about-hero-content">
            <span class="about-eyebrow">Darbak / Auto Parts &amp; Accessories</span>
            <h1 id="about-title">A clearer way to shop for your car.</h1>
            <p>
                Browse parts and accessories, compare product information, save favorites,
                manage your cart, and follow your orders from one focused storefront.
            </p>
            <div class="about-hero-actions">
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">
                    Shop Parts
                </a>
                <a asp-controller="Testimonials" asp-action="Index" class="about-text-link">
                    Customer feedback <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>

        <div class="about-hero-media">
            <div class="about-hero-media-fallback" aria-hidden="true">
                <span>DBK</span>
                <small>Automotive / Precision</small>
            </div>
            <img src="~/images/about/darbak-about-hero.png"
                 alt="Dark performance car in a professional automotive workshop"
                 loading="eager"
                 onerror="this.hidden=true" />
        </div>
    </section>

    <section class="about-editorial" aria-labelledby="about-story-title">
        <div class="about-editorial-heading">
            <span class="section-kicker">What Darbak Is</span>
            <h2 id="about-story-title">Automotive shopping without unnecessary friction.</h2>
        </div>

        <div class="about-editorial-copy">
            <p class="about-lead">
                Darbak is an online store for auto parts and car accessories, built around clear
                product discovery and a straightforward path from browsing to checkout.
            </p>
            <p>
                Search by product or category, use catalog filters, review stock and product details,
                save items to a wishlist, and keep a cart while you continue shopping.
            </p>
            <p>
                Signed-in customers can complete checkout, review current and previous orders,
                open order details and invoices, submit product reviews, and share testimonials.
            </p>
        </div>
    </section>

    <section class="about-flow" aria-labelledby="about-flow-title">
        <header class="about-section-line">
            <div>
                <span class="section-kicker">Shopping Flow</span>
                <h2 id="about-flow-title">From search to order.</h2>
            </div>
        </header>

        <div class="about-flow-grid">
            <article class="about-flow-item">
                <span class="about-flow-index">01</span>
                <div>
                    <h3>Find</h3>
                    <p>Search products and categories, then narrow the catalog with filters and sorting.</p>
                </div>
            </article>
            <article class="about-flow-item">
                <span class="about-flow-index">02</span>
                <div>
                    <h3>Compare</h3>
                    <p>Review product details, availability, images, ratings, and approved customer reviews.</p>
                </div>
            </article>
            <article class="about-flow-item">
                <span class="about-flow-index">03</span>
                <div>
                    <h3>Save &amp; Shop</h3>
                    <p>Keep favorites in your wishlist and continue shopping while your cart is preserved.</p>
                </div>
            </article>
            <article class="about-flow-item">
                <span class="about-flow-index">04</span>
                <div>
                    <h3>Order</h3>
                    <p>Complete checkout, then return to your account for order details, status, and invoice.</p>
                </div>
            </article>
        </div>
    </section>

    <section class="about-principles" aria-labelledby="about-principles-title">
        <div class="about-principles-title">
            <span class="section-kicker">Darbak Experience</span>
            <h2 id="about-principles-title">Useful information stays visible where it matters.</h2>
        </div>

        <div class="about-principles-list">
            <div class="about-principle-row">
                <span>01</span>
                <strong>Product clarity</strong>
                <p>Product details, price, category, stock, and customer feedback remain easy to scan.</p>
            </div>
            <div class="about-principle-row">
                <span>02</span>
                <strong>Shopping continuity</strong>
                <p>Adding an item keeps you in the shopping flow instead of forcing you into the cart.</p>
            </div>
            <div class="about-principle-row">
                <span>03</span>
                <strong>Moderated feedback</strong>
                <p>Reviews and testimonials appear publicly after approval.</p>
            </div>
            <div class="about-principle-row">
                <span>04</span>
                <strong>Order visibility</strong>
                <p>Current and previous orders, details, statuses, and invoices remain accessible from the account.</p>
            </div>
        </div>
    </section>

    <section class="about-testimonials-section about-testimonials--editorial" aria-labelledby="about-testimonials-title">
        <header class="about-section-line">
            <div>
                <span class="section-kicker">Customer Feedback</span>
                <h2 id="about-testimonials-title">Shared by Darbak customers.</h2>
            </div>
            <a asp-controller="Testimonials" asp-action="Index" class="about-text-link">
                View testimonials <span aria-hidden="true">→</span>
            </a>
        </header>

        @if (featuredTestimonial == null)
        {
            <div class="about-testimonial-empty" role="status">
                <strong>No approved testimonials yet.</strong>
                <span>Customer feedback will appear here after moderation.</span>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Testimonials" asp-action="Create">Share your experience →</a>
                }
            </div>
        }
        else
        {
            <div class="about-testimonial-composition @(supportingTestimonials.Any() ? string.Empty : "about-testimonial-composition--single")">
                <article class="about-testimonial-feature">
                    <span class="about-testimonial-quote" aria-hidden="true">“</span>
                    <blockquote>
                        <p>@featuredTestimonial.Content</p>
                    </blockquote>
                    <footer>
                        <strong>@featuredTestimonial.UserName</strong>
                        <time datetime="@featuredTestimonial.CreatedAt.ToString("O")">
                            @featuredTestimonial.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </time>
                    </footer>
                </article>

                @if (supportingTestimonials.Any())
                {
                    <div class="about-testimonial-supporting">
                        @foreach (var testimonial in supportingTestimonials)
                        {
                            <article>
                                <blockquote><p>“@testimonial.Content”</p></blockquote>
                                <footer>
                                    <strong>@testimonial.UserName</strong>
                                    <time datetime="@testimonial.CreatedAt.ToString("O")">
                                        @testimonial.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                                    </time>
                                </footer>
                            </article>
                        }
                    </div>
                }
            </div>
        }
    </section>

    <section class="about-bottom-cta about-bottom-cta--refined" aria-labelledby="about-cta-title">
        <div>
            <span class="section-kicker">Darbak / Catalog</span>
            <h2 id="about-cta-title">Find the part or accessory you need.</h2>
        </div>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary">
            Browse Catalog
        </a>
    </section>
</div>
