@model Darbak.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "About Us";
}

<div class="about-page">
    <section class="about-hero" aria-labelledby="about-title">
        <div class="about-hero-content">
            <span class="about-eyebrow">ABOUT DARBAK</span>
            <h1 id="about-title">Driven by Quality. Built for Every Road.</h1>
            <p>
                Darbak brings auto parts and car accessories into one focused shopping experience,
                making it easier to browse, compare, save, and order the products you need.
            </p>
            <div class="about-hero-actions">
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary btn-lg">
                    Shop Now
                </a>
                <a href="#who-we-are" class="btn btn-outline-light btn-lg">
                    Learn More
                </a>
            </div>
        </div>

        <div class="about-hero-visual" aria-hidden="true">
            <svg viewBox="0 0 620 340" role="img" focusable="false">
                <path class="about-road-line" d="M-10 290 C120 220 230 230 340 170 C430 120 515 105 635 65" />
                <path class="about-car-body" d="M115 212 160 155c13-16 31-25 52-25h120c19 0 38 7 52 20l47 42 64 13c20 4 34 22 34 42v14H90v-18c0-16 10-29 25-31Z" />
                <path class="about-car-window" d="m185 158-31 48h102v-51h-43c-11 0-21 1-28 3Zm92-3v51h118l-35-32c-13-12-28-19-46-19h-37Z" />
                <circle class="about-wheel" cx="176" cy="261" r="36" />
                <circle class="about-wheel-core" cx="176" cy="261" r="15" />
                <circle class="about-wheel" cx="430" cy="261" r="36" />
                <circle class="about-wheel-core" cx="430" cy="261" r="15" />
            </svg>
        </div>
    </section>

    <section id="who-we-are" class="about-story-section" aria-labelledby="who-we-are-title">
        <div class="about-section-heading">
            <span class="section-kicker">Who We Are</span>
            <h2 id="who-we-are-title">A simpler way to shop for your car</h2>
        </div>

        <div class="about-story-grid">
            <div class="about-story-copy">
                <p class="about-lead">
                    Darbak is an online store focused on auto parts and car accessories.
                </p>
                <p>
                    The store is designed to make product discovery straightforward. You can search
                    by product or category, browse available items, review product information and
                    ratings, save favorites to a wishlist, and manage your shopping cart before checkout.
                </p>
                <p>
                    Registered customers can also follow their orders, view detailed order information,
                    access invoices, submit product reviews, and share testimonials that are published
                    after approval.
                </p>
            </div>

            <div class="about-stat-panel" aria-label="Darbak shopping experience">
                <div class="about-stat-item">
                    <strong>Search</strong>
                    <span>Products and categories</span>
                </div>
                <div class="about-stat-item">
                    <strong>Save</strong>
                    <span>Products to your wishlist</span>
                </div>
                <div class="about-stat-item">
                    <strong>Order</strong>
                    <span>From cart to checkout</span>
                </div>
                <div class="about-stat-item">
                    <strong>Track</strong>
                    <span>Current and previous orders</span>
                </div>
            </div>
        </div>
    </section>

    <section class="about-features-section" aria-labelledby="what-we-offer-title">
        <div class="about-section-heading centered">
            <span class="section-kicker">What We Offer</span>
            <h2 id="what-we-offer-title">Everything around the products that matter</h2>
            <p>Core shopping tools already built into Darbak.</p>
        </div>

        <div class="about-feature-grid">
            <article class="about-feature-card">
                <div class="about-feature-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="26" height="26"><path d="M11 4a7 7 0 1 0 4.9 12l4.55 4.55 1.4-1.4L17.3 14.6A7 7 0 0 0 11 4Zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10Z" fill="currentColor" /></svg>
                </div>
                <h3>Smart Product Search</h3>
                <p>Search by product name or category and narrow the catalog using available filters and sorting.</p>
            </article>

            <article class="about-feature-card">
                <div class="about-feature-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="26" height="26"><path d="M12 21s-7.5-4.35-9.6-8.7C.8 8.95 2.55 5 6.45 5c2.05 0 3.35 1.15 4.05 2.2C11.2 6.15 12.5 5 14.55 5c3.9 0 5.65 3.95 4.05 7.3C16.5 16.65 12 21 12 21Z" fill="currentColor" /></svg>
                </div>
                <h3>Wishlist &amp; Cart</h3>
                <p>Save products for later and manage quantities in a persistent shopping cart before checkout.</p>
            </article>

            <article class="about-feature-card">
                <div class="about-feature-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="26" height="26"><path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8-6.2-3.2L5.8 21 7 14.2 2 9.3l6.9-1L12 2Z" fill="currentColor" /></svg>
                </div>
                <h3>Ratings &amp; Reviews</h3>
                <p>Read approved customer reviews and ratings, then submit your own review when signed in.</p>
            </article>

            <article class="about-feature-card">
                <div class="about-feature-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="26" height="26"><path d="M5 3h14v18H5V3Zm2 2v14h10V5H7Zm2 3h6v2H9V8Zm0 4h6v2H9v-2Z" fill="currentColor" /></svg>
                </div>
                <h3>Order History &amp; Invoices</h3>
                <p>Review current and previous orders, open full details, and print an invoice for each order.</p>
            </article>
        </div>
    </section>

    <section class="about-why-section" aria-labelledby="why-darbak-title">
        <div class="about-why-panel">
            <div>
                <span class="section-kicker">Why Choose Darbak</span>
                <h2 id="why-darbak-title">Focused on a clear automotive shopping experience</h2>
            </div>

            <div class="about-check-list">
                <div><span aria-hidden="true">✓</span><p>Clear product information with stock visibility.</p></div>
                <div><span aria-hidden="true">✓</span><p>Approved reviews and testimonials before public display.</p></div>
                <div><span aria-hidden="true">✓</span><p>Guest cart support before login is required for checkout.</p></div>
                <div><span aria-hidden="true">✓</span><p>Order details, statuses, and invoices in one account area.</p></div>
            </div>
        </div>
    </section>

    <section class="about-testimonials-section" aria-labelledby="about-testimonials-title">
        <div class="about-section-heading centered">
            <span class="section-kicker">Customer Feedback</span>
            <h2 id="about-testimonials-title">What Our Customers Say</h2>
            <p>Only testimonials approved for public display are shown here.</p>
        </div>

        @if (!Model.Testimonials.Any())
        {
            <div class="empty-state about-empty-state">
                <div class="empty-state-icon" aria-hidden="true">“</div>
                <h3>No testimonials yet</h3>
                <p>Approved customer testimonials will appear here when available.</p>
            </div>
        }
        else
        {
            <div class="about-testimonial-grid">
                @foreach (var testimonial in Model.Testimonials)
                {
                    <article class="about-testimonial-card">
                        <div class="about-quote-mark" aria-hidden="true">“</div>
                        <blockquote>
                            <p>@testimonial.Content</p>
                        </blockquote>
                        <footer>
                            <strong>@testimonial.UserName</strong>
                            <time datetime="@testimonial.CreatedAt.ToString("O")">
                                @testimonial.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                            </time>
                        </footer>
                    </article>
                }
            </div>
        }
    </section>

    <section class="about-bottom-cta" aria-labelledby="about-cta-title">
        <div>
            <span class="section-kicker">Explore Darbak</span>
            <h2 id="about-cta-title">Ready to find what your car needs?</h2>
            <p>Browse the current catalog of auto parts and car accessories.</p>
        </div>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary btn-lg">
            Shop Now
        </a>
    </section>
</div>
