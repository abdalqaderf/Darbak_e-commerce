@model IEnumerable<Darbak.Models.Category>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Categories"; var search = ViewBag.Search as string; }
<div class="admin-page-heading"><div><span class="admin-page-heading__eyebrow">Catalog</span><h1>Categories</h1><p>Organize products into clear catalog groups.</p></div><a asp-action="Create" class="btn btn-primary">Add Category</a></div>
<section class="admin-filter-panel" aria-labelledby="category-filter-title"><div class="admin-filter-panel__header"><div><span>Filters</span><h2 id="category-filter-title">Find Categories</h2></div><span class="admin-result-count">@Model.Count() result(s)</span></div><form asp-action="Index" method="get" class="admin-filter-grid admin-filter-grid--compact"><div class="admin-filter-field admin-filter-field--wide"><label for="search">Category Name</label><input type="search" id="search" name="search" value="@search" class="form-control" placeholder="Search categories" /></div><div class="admin-filter-actions"><button type="submit" class="btn btn-primary">Search</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></form></section>
<section class="admin-panel"><div class="admin-panel__header"><div><span class="admin-panel__eyebrow">Catalog</span><h2>Category List</h2></div></div>
@if (!Model.Any()) { <div class="admin-empty-state"><strong>No categories found</strong><span>No categories match the current search.</span><a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear Search</a></div> }
else { <div class="table-responsive" tabindex="0"><table class="table admin-table align-middle mb-0"><caption class="visually-hidden">Product categories</caption><thead><tr><th>Category</th><th>Description</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach (var category in Model) { <tr><td><strong>@category.Name</strong></td><td class="admin-table__description">@(string.IsNullOrWhiteSpace(category.Description) ? "No description" : category.Description)</td><td class="text-end"><div class="admin-actions"><a asp-action="Edit" asp-route-id="@category.Id" class="admin-table-action">Edit</a><a asp-action="Delete" asp-route-id="@category.Id" class="admin-table-action admin-table-action--danger">Delete</a></div></td></tr> }</tbody></table></div> }
</section>
