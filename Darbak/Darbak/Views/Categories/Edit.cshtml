@model Darbak.Models.Category

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Category";
}

<div class="admin-page-heading">
    <div>
        <span class="admin-page-heading__eyebrow">Catalog</span>
        <h1>Edit Category</h1>
        <p>Update the category details and storefront image.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Back to Categories
    </a>
</div>

<section class="admin-form-card">
    <form asp-action="Edit"
          method="post"
          enctype="multipart/form-data">

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="validation-summary-errors"></div>

        <div class="admin-form-grid">
            <div class="admin-form-field admin-form-field--full">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="admin-form-field admin-form-field--full">
                <label asp-for="Description"></label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="admin-form-field admin-form-field--full">
                <label for="imageFile">Category Image</label>

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <div class="admin-category-image-current">
                        <img src="@Model.ImageUrl"
                             alt="Current image for @Model.Name"
                             onerror="this.closest('.admin-category-image-current').hidden=true" />
                        <div>
                            <strong>Current image</strong>
                            <span>Upload a new image to replace it.</span>
                        </div>
                    </div>
                }

                <input id="imageFile"
                       name="imageFile"
                       type="file"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                <span class="admin-field-hint">
                    JPG, JPEG, PNG, or WebP. Maximum size: 5 MB.
                </span>

                @Html.ValidationMessage("imageFile", null, new { @class = "text-danger" })

                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <label class="admin-category-remove-image">
                        <input type="checkbox"
                               name="removeImage"
                               value="true" />
                        <span>Remove current image</span>
                    </label>
                }
            </div>
        </div>

        <div class="admin-form-actions">
            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
