@using Darbak.Models.Enums
@model IEnumerable<Darbak.Models.Review>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reviews";
    string? selectedStatus = ViewBag.Status as string;
    string? productFilter = ViewBag.ProductFilter as string;
    string? userFilter = ViewBag.UserFilter as string;
    int? selectedRating = ViewBag.Rating != null ? (int?)ViewBag.Rating : null;
}
<div class="admin-page-heading"><div><span class="admin-page-heading__eyebrow">Moderation</span><h1>Reviews</h1><p>Moderate product reviews and ratings before they appear publicly.</p></div><span class="admin-heading-count">@Model.Count() reviews</span></div>
<section class="admin-filter-panel"><div class="admin-filter-panel__header"><div><span>Filters</span><h2>Find Reviews</h2></div><span class="admin-result-count">@Model.Count() result(s)</span></div><form asp-action="Index" method="get" class="admin-filter-grid">
<div class="admin-filter-field"><label for="status">Status</label><select id="status" name="status" class="form-select"><option value="">All Statuses</option>@foreach (var value in Enum.GetValues<ApprovalStatus>()) { if (selectedStatus == value.ToString()) { <option value="@value" selected>@value</option> } else { <option value="@value">@value</option> } }</select></div>
<div class="admin-filter-field"><label for="product">Product</label><input type="search" id="product" name="product" value="@productFilter" class="form-control" placeholder="Product name" /></div>
<div class="admin-filter-field admin-filter-field--wide"><label for="user">User</label><input type="search" id="user" name="user" value="@userFilter" class="form-control" placeholder="Name or email" /></div>
<div class="admin-filter-field"><label for="rating">Rating</label><select id="rating" name="rating" class="form-select"><option value="">All Ratings</option>@for (var i = 5; i >= 1; i--) { if (selectedRating == i) { <option value="@i" selected>@i stars</option> } else { <option value="@i">@i stars</option> } }</select></div>
<div class="admin-filter-actions"><button type="submit" class="btn btn-primary">Apply Filters</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></form></section>
<section class="admin-panel"><div class="admin-panel__header"><div><span class="admin-panel__eyebrow">Moderation Queue</span><h2>Review List</h2></div></div>
@if (!Model.Any()) { <div class="admin-empty-state"><strong>No reviews found</strong><span>No reviews match the selected filters.</span><a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear Filters</a></div> }
else { <div class="table-responsive" tabindex="0"><table class="table admin-table admin-table--content align-middle mb-0"><caption class="visually-hidden">Product reviews awaiting or receiving moderation</caption><thead><tr><th>Product</th><th>User</th><th>Rating</th><th>Comment</th><th>Status</th><th>Date</th><th class="text-end">Actions</th></tr></thead><tbody>
@foreach (var review in Model) {
    var statusClass = review.Status switch { ApprovalStatus.Approved => "status-badge status-badge--success", ApprovalStatus.Rejected => "status-badge status-badge--danger", _ => "status-badge status-badge--warning" };
<tr><td><strong>@review.Product.Name</strong></td><td><strong>@(string.IsNullOrWhiteSpace(review.User.FullName) ? "User" : review.User.FullName)</strong><small>@review.User.Email</small></td><td><span class="admin-rating" aria-label="@review.Rating out of 5">★ @review.Rating/5</span></td><td><p class="admin-table-comment">@review.Comment</p></td><td><span class="@statusClass">@review.Status</span></td><td>@review.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td class="text-end"><div class="admin-actions">@if (review.Status != ApprovalStatus.Approved) { <form asp-action="Approve" method="post"><input type="hidden" name="id" value="@review.Id" /><button type="submit" class="admin-table-action admin-table-action--success">Approve</button></form> } @if (review.Status != ApprovalStatus.Rejected) { <form asp-action="Reject" method="post"><input type="hidden" name="id" value="@review.Id" /><button type="submit" class="admin-table-action admin-table-action--danger">Reject</button></form> }</div></td></tr> }
</tbody></table></div> }
</section>
