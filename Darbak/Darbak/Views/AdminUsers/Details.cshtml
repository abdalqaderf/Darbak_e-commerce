@model Darbak.ViewModels.AdminUserDetailsViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "User Details"; }
<div class="admin-page-heading"><div><span class="admin-page-heading__eyebrow">Access</span><h1>User Details</h1><p>Review account information and manage the user's role.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to Users</a></div>
<div class="admin-dashboard-grid admin-dashboard-grid--equal">
<section class="admin-panel"><div class="admin-panel__header"><div><span class="admin-panel__eyebrow">Account</span><h2>User Information</h2></div></div><div class="admin-definition-list"><div><span>Full Name</span><strong>@(string.IsNullOrWhiteSpace(Model.FullName) ? "Not provided" : Model.FullName)</strong></div><div><span>Email</span><strong>@Model.Email</strong></div><div><span>Username</span><strong>@(string.IsNullOrWhiteSpace(Model.UserName) ? "Not provided" : Model.UserName)</strong></div><div><span>Current Role</span><strong>@if (!Model.Roles.Any()) { <span class="status-badge status-badge--muted">No Role</span> } else { @foreach (var role in Model.Roles) { <span class="@(role == "Admin" ? "status-badge status-badge--danger" : "status-badge status-badge--info")">@role</span> } }</strong></div></div></section>
<section class="admin-panel"><div class="admin-panel__header"><div><span class="admin-panel__eyebrow">Permissions</span><h2>Change Role</h2></div></div><form asp-action="ChangeRole" method="post" class="admin-role-form"><input type="hidden" name="userId" value="@Model.Id" /><label for="selectedRole">Role</label><select id="selectedRole" name="selectedRole" class="form-select">@if (Model.SelectedRole == "User") { <option value="User" selected>User</option><option value="Admin">Admin</option> } else { <option value="User">User</option><option value="Admin" selected>Admin</option> }</select><div class="alert alert-warning">Role changes affect access immediately. Existing self-protection rules remain enforced by the controller.</div><button type="submit" class="btn btn-primary">Save Role</button></form></section>
</div>
