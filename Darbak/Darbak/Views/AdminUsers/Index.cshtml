@model Darbak.ViewModels.AdminUsersViewModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Users"; string? search = ViewBag.Search as string; string? selectedRole = ViewBag.Role as string; }
<div class="admin-page-heading"><div><span class="admin-page-heading__eyebrow">Access</span><h1>Users</h1><p>Search registered users and manage account roles.</p></div><span class="admin-heading-count">@Model.Users.Count users</span></div>
<section class="admin-filter-panel"><div class="admin-filter-panel__header"><div><span>Filters</span><h2>Find Users</h2></div><span class="admin-result-count">@Model.Users.Count result(s)</span></div><form asp-action="Index" method="get" class="admin-filter-grid admin-filter-grid--compact"><div class="admin-filter-field admin-filter-field--wide"><label for="userSearch">Name or Email</label><input type="search" id="userSearch" name="search" value="@search" class="form-control" placeholder="Search users" autocomplete="off" /></div><div class="admin-filter-field"><label for="userRole">Role</label><select id="userRole" name="role" class="form-select"><option value="">All Roles</option>@if (selectedRole == "Admin") { <option value="Admin" selected>Admin</option> } else { <option value="Admin">Admin</option> } @if (selectedRole == "User") { <option value="User" selected>User</option> } else { <option value="User">User</option> }</select></div><div class="admin-filter-actions"><button type="submit" class="btn btn-primary">Apply Filters</button><a asp-action="Index" class="btn btn-outline-secondary">Reset</a></div></form></section>
<section class="admin-panel"><div class="admin-panel__header"><div><span class="admin-panel__eyebrow">Accounts</span><h2>User List</h2></div></div>
@if (!Model.Users.Any()) { <div class="admin-empty-state"><strong>No users found</strong><span>No users match the selected filters.</span><a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear Filters</a></div> }
else { <div class="table-responsive" tabindex="0"><table class="table admin-table align-middle mb-0"><caption class="visually-hidden">Registered users</caption><thead><tr><th>User</th><th>Email</th><th>Role</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach (var user in Model.Users) { <tr><td><strong>@(string.IsNullOrWhiteSpace(user.FullName) ? "Not provided" : user.FullName)</strong></td><td>@user.Email</td><td>@if (!user.Roles.Any()) { <span class="status-badge status-badge--muted">No Role</span> } else { @foreach (var role in user.Roles) { <span class="@(role == "Admin" ? "status-badge status-badge--danger" : "status-badge status-badge--info")">@role</span> } }</td><td class="text-end"><a asp-action="Details" asp-route-id="@user.Id" class="admin-table-action">Manage</a></td></tr> }</tbody></table></div> }
</section>
