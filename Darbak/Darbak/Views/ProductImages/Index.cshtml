@model Darbak.Models.Product
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Product Images";
}
<div class="admin-page-heading">
    <div><span class="admin-page-heading__eyebrow">Catalog</span><h1>Product Images</h1><p>Manage gallery images for <strong>@Model.Name</strong>.</p></div>
    <div class="d-flex gap-2 flex-wrap"><a asp-action="Create" asp-route-productId="@Model.Id" class="btn btn-primary">Add Image</a><a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Back to Products</a></div>
</div>
@if (!Model.Images.Any())
{
    <div class="admin-empty-state admin-empty-state--panel"><strong>No product images</strong><span>Upload the first image for this product.</span><a asp-action="Create" asp-route-productId="@Model.Id" class="btn btn-primary btn-sm">Upload Image</a></div>
}
else
{
    <div class="admin-image-grid">
        @foreach (var image in Model.Images.OrderByDescending(i => i.IsMain).ThenBy(i => i.Id))
        {
            <article class="admin-image-card">
                <div class="admin-image-card__media"><img src="@image.ImageUrl" alt="@Model.Name product image" /></div>
                <div class="admin-image-card__body">
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <span class="@(image.IsMain ? "status-badge status-badge--success" : "status-badge status-badge--muted")">@(image.IsMain ? "Main Image" : "Gallery Image")</span>
                        <small>#@image.Id</small>
                    </div>
                    <p class="admin-image-card__path">@image.ImageUrl</p>
                    <div class="admin-actions">
                        @if (!image.IsMain)
                        {
                            <form asp-action="SetMain" method="post"><input type="hidden" name="id" value="@image.Id" /><button type="submit" class="admin-table-action">Set as Main</button></form>
                        }
                        <form asp-action="Delete"
                              method="post"
                              data-confirm
                              data-confirm-title="Delete image?"
                              data-confirm-message="Delete this product image?"
                              data-confirm-button="Delete">
                            <input type="hidden" name="id" value="@image.Id" />
                            <button type="submit" class="admin-table-action admin-table-action--danger">Delete</button>
                        </form>
                    </div>
                </div>
            </article>
        }
    </div>
}
