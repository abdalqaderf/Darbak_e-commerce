@model Darbak.Models.Product

@{
    ViewData["Title"] = Model.Name;
    var currentReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var images = Model.Images
        .OrderByDescending(i => i.IsMain)
        .ThenBy(i => i.Id)
        .ToList();

    var mainImage = images.FirstOrDefault();

    var approvedReviews = Model.Reviews
        .OrderByDescending(r => r.CreatedAt)
        .ToList();

    var averageRating = approvedReviews.Any()
        ? approvedReviews.Average(r => r.Rating)
        : 0;

    var reviewCount = approvedReviews.Count;
}

<div class="product-details-page">
    <div class="container">
        <nav class="darbak-breadcrumb" aria-label="Breadcrumb">
            <ol>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Catalog" asp-action="Index">Shop</a></li>
                <li>
                    <a asp-controller="Catalog"
                       asp-action="Index"
                       asp-route-categoryId="@Model.CategoryId">
                        @Model.Category.Name
                    </a>
                </li>
                <li aria-current="page">@Model.Name</li>
            </ol>
        </nav>

        <div class="product-details-shell">
            <section class="product-gallery" aria-label="Product images">
                <div class="product-gallery-frame @(images.Count > 1 ? "has-thumbnails" : "single-image")">
                    @if (images.Count > 1)
                    {
                        <div class="product-thumbnail-list" aria-label="Choose product image">
                            @foreach (var image in images)
                            {
                                <button type="button"
                                        class="product-thumbnail @(image.Id == mainImage?.Id ? "is-active" : string.Empty)"
                                        data-product-thumbnail
                                        data-image-url="@image.ImageUrl"
                                        data-image-alt="@Model.Name"
                                        aria-label="View image of @Model.Name"
                                        aria-pressed="@(image.Id == mainImage?.Id ? "true" : "false")">
                                    <img src="@image.ImageUrl"
                                         alt=""
                                         loading="lazy"
                                         onerror="this.closest('button').style.display='none';" />

                                    @if (image.IsMain)
                                    {
                                        <span class="product-thumbnail-main">Main</span>
                                    }
                                </button>
                            }
                        </div>
                    }

                    <div class="product-main-media">
                        <span class="product-media-index" aria-hidden="true">DBK / PRODUCT</span>

                        <div id="product-main-fallback"
                             class="product-image-placeholder"
                             role="img"
                             aria-label="No image available for @Model.Name"
                             style="display: @(mainImage == null ? "flex" : "none");">
                            <strong>DBK</strong>
                            <span>No image available</span>
                        </div>

                        @if (mainImage != null)
                        {
                            <img id="product-main-image"
                                 src="@mainImage.ImageUrl"
                                 alt="@Model.Name"
                                 class="product-main-image"
                                 onload="this.style.display='block'; document.getElementById('product-main-fallback').style.display='none';"
                                 onerror="this.style.display='none'; document.getElementById('product-main-fallback').style.display='flex';" />
                        }
                    </div>
                </div>
            </section>

            <section class="product-purchase-panel" aria-labelledby="product-title">
                <div class="product-purchase-intro">
                    <a asp-controller="Catalog"
                       asp-action="Index"
                       asp-route-categoryId="@Model.CategoryId"
                       class="product-category-label">
                        @Model.Category.Name
                    </a>
                    <span class="product-reference">PRODUCT / @Model.Id.ToString("D4")</span>
                </div>

                <h1 id="product-title" class="product-details-title">@Model.Name</h1>

                <div class="product-rating-row">
                    @if (reviewCount > 0)
                    {
                        <div class="product-rating-stars"
                             aria-label="Average rating @averageRating.ToString("0.0") out of 5">
                            @for (var star = 1; star <= 5; star++)
                            {
                                <span class="@(star <= Math.Round(averageRating) ? "is-filled" : string.Empty)" aria-hidden="true">★</span>
                            }
                        </div>

                        <a href="#customer-reviews" class="product-rating-link">
                            @averageRating.ToString("0.0") · @reviewCount @(reviewCount == 1 ? "review" : "reviews")
                        </a>
                    }
                    else
                    {
                        <a href="#customer-reviews" class="product-no-rating">No reviews yet</a>
                    }
                </div>

                <div class="product-price-row">
                    <div class="product-details-price">
                        @Model.Price.ToString("0.00") <span>JD</span>
                    </div>

                    <div class="product-stock-row">
                        @if (!Model.IsActive)
                        {
                            <span class="stock-status stock-status--muted"><span></span>Inactive</span>
                        }
                        else if (Model.StockQuantity <= 0)
                        {
                            <span class="stock-status stock-status--out"><span></span>Out of stock</span>
                        }
                        else
                        {
                            <span class="stock-status stock-status--in"><span></span>In stock</span>
                        }
                    </div>
                </div>

                <div class="product-fact-grid" aria-label="Product facts">
                    <div>
                        <span>Category</span>
                        <strong>@Model.Category.Name</strong>
                    </div>
                    <div>
                        <span>Availability</span>
                        <strong>@(Model.StockQuantity > 0 ? $"{Model.StockQuantity} units" : "Unavailable")</strong>
                    </div>
                    <div>
                        <span>Status</span>
                        <strong>@(Model.IsActive ? "Active" : "Inactive")</strong>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="product-summary-copy">@Model.Description</p>
                }

                <div class="product-action-panel">
                    @if (Model.IsActive && Model.StockQuantity > 0)
                    {
                        <form asp-controller="Cart"
                              asp-action="AddToCart"
                              method="post"
                              class="product-cart-form">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <input type="hidden" name="returnUrl" value="@currentReturnUrl" />

                            <button type="submit" class="product-add-cart-btn">
                                <span>Add to cart</span>
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM6.2 6l.7 4H18l1.4-4H6.2Zm-1.7-4H2V4h1.8l2.2 11.1A2 2 0 0 0 8 17h10v-2H8l-.4-2h10.8a2 2 0 0 0 1.9-1.4L22 6a2 2 0 0 0-1.9-2H5.8l-.3-1.2A1 1 0 0 0 4.5 2Z" />
                                </svg>
                            </button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="product-add-cart-btn" disabled>
                            @(Model.IsActive ? "Out of stock" : "Unavailable")
                        </button>
                    }

                    @if (Model.IsActive)
                    {
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Wishlist" asp-action="Add" method="post" class="product-wishlist-form">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <button type="submit" class="product-wishlist-btn" aria-label="Add @Model.Name to wishlist">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M12 21.4 10.6 20C5.4 15.4 2 12.3 2 8.5A5.5 5.5 0 0 1 7.5 3 6 6 0 0 1 12 5.1 6 6 0 0 1 16.5 3 5.5 5.5 0 0 1 22 8.5c0 3.8-3.4 6.9-8.6 11.5L12 21.4ZM7.5 5A3.5 3.5 0 0 0 4 8.5c0 2.7 2.7 5.3 8 10 5.3-4.7 8-7.3 8-10A3.5 3.5 0 0 0 16.5 5c-1.5 0-2.9.9-3.5 2.2h-2A3.9 3.9 0 0 0 7.5 5Z" />
                                    </svg>
                                    <span>Save</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-area="Identity"
                               asp-page="/Account/Login"
                               asp-route-returnUrl="@($"/Products/Details/{Model.Id}")"
                               class="product-wishlist-btn">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M12 21.4 10.6 20C5.4 15.4 2 12.3 2 8.5A5.5 5.5 0 0 1 7.5 3 6 6 0 0 1 12 5.1 6 6 0 0 1 16.5 3 5.5 5.5 0 0 1 22 8.5c0 3.8-3.4 6.9-8.6 11.5L12 21.4Z" />
                                </svg>
                                <span>Save</span>
                            </a>
                        }
                    }
                </div>

                <div class="product-checkout-note">
                    <span>CHECKOUT CHECK</span>
                    Price and stock are verified again before the order is created.
                </div>
            </section>
        </div>

        <div class="product-content-nav" aria-label="Product information sections">
            <a href="#product-description">Description</a>
            <a href="#customer-reviews">Reviews <span>@reviewCount.ToString("D2")</span></a>
        </div>

        <section id="product-description" class="product-content-section product-description-section">
            <div class="product-section-heading">
                <span class="product-section-index">01</span>
                <div>
                    <span class="product-section-eyebrow">Product information</span>
                    <h2>Description</h2>
                </div>
            </div>

            <div class="product-description-content">
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p>@Model.Description</p>
                }
                else
                {
                    <div class="product-section-empty">
                        <strong>No description available</strong>
                        <span>More product information has not been added yet.</span>
                    </div>
                }
            </div>
        </section>

        <section id="customer-reviews" class="product-content-section product-reviews-section">
            <div class="product-review-header">
                <div class="product-section-heading">
                    <span class="product-section-index">02</span>
                    <div>
                        <span class="product-section-eyebrow">Customer feedback</span>
                        <h2>Reviews</h2>
                    </div>
                </div>

                @if (Model.IsActive)
                {
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Reviews"
                           asp-action="Create"
                           asp-route-productId="@Model.Id"
                           class="product-review-action">
                            Write a review →
                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@($"/Reviews/Create?productId={Model.Id}")"
                           class="product-review-action">
                            Sign in to review →
                        </a>
                    }
                }
            </div>

            @if (reviewCount == 0)
            {
                <div class="product-reviews-empty">
                    <span>NO APPROVED REVIEWS</span>
                    <strong>Customer feedback will appear here after moderation.</strong>
                </div>
            }
            else
            {
                <div class="product-review-layout">
                    <aside class="product-review-summary">
                        <div class="product-review-score">
                            <strong>@averageRating.ToString("0.0")</strong>
                            <span>/ 5.0</span>
                        </div>
                        <div class="product-rating-stars product-rating-stars-large"
                             aria-label="Average rating @averageRating.ToString("0.0") out of 5">
                            @for (var star = 1; star <= 5; star++)
                            {
                                <span class="@(star <= Math.Round(averageRating) ? "is-filled" : string.Empty)" aria-hidden="true">★</span>
                            }
                        </div>
                        <p>Based on @reviewCount @(reviewCount == 1 ? "approved review" : "approved reviews")</p>
                    </aside>

                    <div class="product-review-list">
                        @foreach (var review in approvedReviews)
                        {
                            var reviewerName = !string.IsNullOrWhiteSpace(review.User.FullName)
                                ? review.User.FullName
                                : review.User.UserName ?? "Customer";

                            <article class="product-review-card">
                                <div class="product-review-card-header">
                                    <div class="product-review-author">
                                        <div class="product-review-avatar" aria-hidden="true">
                                            @reviewerName.Substring(0, 1).ToUpperInvariant()
                                        </div>
                                        <div>
                                            <h3>@reviewerName</h3>
                                            <time datetime="@review.CreatedAt.ToString("O")">
                                                @review.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")
                                            </time>
                                        </div>
                                    </div>

                                    <div class="product-rating-stars" aria-label="Rating @review.Rating out of 5">
                                        @for (var star = 1; star <= 5; star++)
                                        {
                                            <span class="@(star <= review.Rating ? "is-filled" : string.Empty)" aria-hidden="true">★</span>
                                        }
                                    </div>
                                </div>
                                <p>@review.Comment</p>
                            </article>
                        }
                    </div>
                </div>
            }
        </section>

        @if (User.IsInRole("Admin"))
        {
            <section class="product-admin-actions" aria-label="Admin product actions">
                <div>
                    <span class="product-section-eyebrow">Administrator</span>
                    <h2>Product Management</h2>
                </div>
                <div class="product-admin-actions-buttons">
                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit Product</a>
                    <a asp-controller="ProductImages" asp-action="Index" asp-route-productId="@Model.Id" class="btn btn-secondary">Manage Images</a>
                </div>
            </section>
        }
    </div>
</div>
