@model Darbak.Models.Product
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Edit Product"; }
<div class="admin-page-heading"><div><span class="admin-page-heading__eyebrow">Catalog</span><h1>Edit Product</h1><p>Update product details, pricing, stock, and visibility.</p></div><div class="d-flex gap-2"><a asp-controller="ProductImages" asp-action="Index" asp-route-productId="@Model.Id" class="btn btn-outline-secondary">Manage Images</a><a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
<section class="admin-form-card"><form asp-action="Edit" method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
<div class="admin-form-grid">
<div class="admin-form-field admin-form-field--full"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="admin-form-field admin-form-field--full"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="admin-form-field"><label asp-for="Price"></label><input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" /><span asp-validation-for="Price" class="text-danger"></span></div>
<div class="admin-form-field"><label asp-for="StockQuantity">Stock Quantity</label><input asp-for="StockQuantity" class="form-control" type="number" min="0" /><span asp-validation-for="StockQuantity" class="text-danger"></span></div>
<div class="admin-form-field"><label asp-for="CategoryId">Category</label><select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select"></select><span asp-validation-for="CategoryId" class="text-danger"></span></div>
<div class="admin-form-field admin-form-field--toggle"><div class="form-check form-switch"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active and visible in the store</label></div></div>
</div><div class="admin-form-actions"><button type="submit" class="btn btn-primary">Save Changes</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
