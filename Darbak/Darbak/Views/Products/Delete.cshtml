@model Darbak.Models.Product
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Delete Product"; }
<div class="admin-page-heading"><div><span class="admin-page-heading__eyebrow">Catalog</span><h1>Delete Product</h1><p>Review the product before removing it from the catalog.</p></div><a asp-action="Index" class="btn btn-outline-secondary">Back to Products</a></div>
<section class="admin-form-card admin-form-card--danger">
<div class="admin-definition-grid"><div><span>Product</span><strong>@Model.Name</strong></div><div><span>Category</span><strong>@Model.Category.Name</strong></div><div><span>Price</span><strong>@Model.Price.ToString("0.00")</strong></div><div><span>Stock</span><strong>@Model.StockQuantity</strong></div></div>
@if (Model.OrderItems.Any()) { <div class="alert alert-danger mt-4"><strong>Deletion blocked.</strong> This product exists in previous orders. Deactivate it instead to preserve order history.</div><div class="admin-form-actions"><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit / Deactivate</a><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div> }
else { <div class="alert alert-warning mt-4">This action permanently removes the product. This cannot be undone.</div><form asp-action="Delete" method="post" class="admin-form-actions"><input asp-for="Id" type="hidden" /><button type="submit" class="btn btn-danger">Delete Product</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form> }
</section>
