@using Darbak.Models.Enums
@model Darbak.ViewModels.AdminDashboardViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="admin-page-heading admin-page-heading--dashboard">
    <div>
        <span class="admin-page-heading__eyebrow">Store Operations</span>
        <h1>Dashboard</h1>
        <p>Orders, inventory, moderation, and account activity in one view.</p>
    </div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Open Store</a>
</div>

<section class="admin-command-strip" aria-label="Store overview">
    <div class="admin-command-metric">
        <span>Products</span>
        <strong>@Model.TotalProducts</strong>
        <small>@Model.ActiveProducts active</small>
    </div>
    <div class="admin-command-metric">
        <span>Categories</span>
        <strong>@Model.TotalCategories</strong>
        <small>Catalog groups</small>
    </div>
    <div class="admin-command-metric">
        <span>Users</span>
        <strong>@Model.TotalUsers</strong>
        <small>Registered accounts</small>
    </div>
    <div class="admin-command-metric">
        <span>Orders</span>
        <strong>@Model.TotalOrders</strong>
        <small>All orders</small>
    </div>
    <div class="admin-command-metric admin-command-metric--value">
        <span>Order Value</span>
        <strong>@Model.TotalOrderValue.ToString("0.00") <em>JD</em></strong>
        <small>Recorded total</small>
    </div>
</section>

<section class="admin-priority-strip" aria-label="Moderation queues">
    <div class="admin-priority-strip__label">
        <span class="admin-panel__eyebrow">Attention</span>
        <strong>Moderation queue</strong>
    </div>
    <a asp-controller="Reviews" asp-action="Index" class="admin-priority-item">
        <span>Pending reviews</span>
        <strong>@Model.PendingReviews</strong>
        <small>Review queue →</small>
    </a>
    <a asp-controller="Testimonials" asp-action="AdminIndex" class="admin-priority-item">
        <span>Pending testimonials</span>
        <strong>@Model.PendingTestimonials</strong>
        <small>Testimonial queue →</small>
    </a>
</section>

<div class="admin-dashboard-grid">
    <section class="admin-panel" aria-labelledby="recent-orders-title">
        <div class="admin-panel__header">
            <div>
                <span class="admin-panel__eyebrow">Sales</span>
                <h2 id="recent-orders-title">Recent Orders</h2>
            </div>
            <a asp-controller="Orders" asp-action="AdminIndex" class="admin-panel__link">All orders →</a>
        </div>

        @if (!Model.RecentOrders.Any())
        {
            <div class="admin-empty-state">
                <strong>No orders yet</strong>
                <span>New orders will appear here.</span>
            </div>
        }
        else
        {
            <div class="table-responsive" tabindex="0">
                <table class="table admin-table align-middle mb-0">
                    <caption class="visually-hidden">Recent orders</caption>
                    <thead>
                        <tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        var statusClass = order.Status switch
                        {
                            OrderStatus.Completed => "status-badge status-badge--success",
                            OrderStatus.Cancelled => "status-badge status-badge--danger",
                            _ => "status-badge status-badge--warning"
                        };
                        <tr>
                            <td><strong>#@order.Id</strong><small>@order.OrderDate.ToLocalTime().ToString("dd MMM yyyy")</small></td>
                            <td>@order.UserName</td>
                            <td><strong>@order.TotalAmount.ToString("0.00") JD</strong></td>
                            <td><span class="@statusClass">@order.Status</span></td>
                            <td class="text-end"><a asp-controller="Orders" asp-action="AdminDetails" asp-route-id="@order.Id" class="admin-table-action">Open</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="admin-panel" aria-labelledby="low-stock-title">
        <div class="admin-panel__header">
            <div>
                <span class="admin-panel__eyebrow">Inventory</span>
                <h2 id="low-stock-title">Low Stock</h2>
            </div>
            <a asp-controller="Products" asp-action="Index" class="admin-panel__link">Products →</a>
        </div>

        @if (!Model.LowStockProducts.Any())
        {
            <div class="admin-empty-state">
                <strong>Stock levels are clear</strong>
                <span>Products at five units or fewer will appear here.</span>
            </div>
        }
        else
        {
            <div class="admin-list-stack">
                @foreach (var product in Model.LowStockProducts)
                {
                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id" class="admin-list-item">
                        <span>
                            <strong>@product.Name</strong>
                            <small>@product.Price.ToString("0.00") JD</small>
                        </span>
                        <span class="@(product.StockQuantity == 0 ? "status-badge status-badge--danger" : "status-badge status-badge--warning")">
                            @product.StockQuantity in stock
                        </span>
                    </a>
                }
            </div>
        }
    </section>
</div>

<div class="admin-dashboard-grid admin-dashboard-grid--equal">
    <section class="admin-panel" aria-labelledby="order-status-title">
        <div class="admin-panel__header">
            <div><span class="admin-panel__eyebrow">Orders</span><h2 id="order-status-title">Order Status</h2></div>
        </div>
        <div class="admin-status-list">
            @foreach (var item in Model.OrdersByStatus)
            {
                <div><span>@item.Key</span><strong>@item.Value</strong></div>
            }
        </div>
    </section>

    <section class="admin-panel" aria-labelledby="payment-status-title">
        <div class="admin-panel__header">
            <div><span class="admin-panel__eyebrow">Payments</span><h2 id="payment-status-title">Payment Status</h2></div>
        </div>
        <div class="admin-status-list">
            @foreach (var item in Model.OrdersByPaymentStatus)
            {
                <div><span>@item.Key</span><strong>@item.Value</strong></div>
            }
        </div>
    </section>
</div>
